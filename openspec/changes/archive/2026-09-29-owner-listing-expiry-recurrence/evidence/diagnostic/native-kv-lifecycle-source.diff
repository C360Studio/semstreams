+func TestKVFilterDiagnosticCompletionJoinBound(t *testing.T) {
+	ctx, cancel := context.WithCancel(t.Context())
+	decorator := &kvDiagnosticBucketDecorator{completionStop: func() bool { return false }, completionDone: make(chan struct{})}
+	cancel()
+	if err := decorator.joinCompletion(ctx); !errors.Is(err, context.Canceled) {
+		t.Fatalf("unjoined context callback did not report cancellation: %v", err)
+	}
