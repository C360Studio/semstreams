{
  "version": "1.1.0",
  "platform": {
    "org": "c360",
    "id": "semstreams-agentic",
    "type": "agentic-e2e",
    "region": "local",
    "instance_id": "agentic-001",
    "environment": "test"
  },
  "tier": "agentic",
  "nats": {
    "urls": ["nats://localhost:4222"]
  },
  "streams": {
    "AGENT": {
      "subjects": [
        "agent.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "ENTITY": {
      "subjects": [
        "entity.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "RULE": {
      "subjects": [
        "rule.>"
      ],
      "max_age": "24h",
      "max_bytes": 67108864,
      "discard": "old"
    },
    "TOOL": {
      "subjects": [
        "tool.execute.>",
        "tool.result.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    }
  },
  "model_registry": {
    "endpoints": {
      "mock": {
        "provider": "openai",
        "url": "http://mock-llm:8080/v1",
        "model": "mock-model",
        "max_tokens": 4096,
        "supports_tools": true,
        "tool_format": "openai",
        "stream": true
      }
    },
    "defaults": {
      "model": "mock"
    }
  },
  "services": {
    "service-manager": {
      "enabled": true,
      "config": {
        "http_port": 8080,
        "swagger_ui": true,
        "server_info": {
          "title": "SemStreams Agentic Tier - Agent Loop Testing",
          "description": "Agentic components with mock LLM for E2E testing",
          "version": "0.7.0"
        }
      }
    },
    "component-manager": {
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "enabled": true,
      "config": {
        "port": 9090,
        "path": "/metrics"
      }
    },
    "message-logger": {
      "enabled": true,
      "config": {
        "monitor_subjects": ["agent.*", "tool.*"]
      }
    },
    "log-forwarder": {
      "enabled": true,
      "config": {
        "min_level": "DEBUG",
        "exclude_sources": []
      }
    },
    "metrics-forwarder": {
      "enabled": true,
      "config": {
        "push_interval": "5s",
        "include_go_metrics": false,
        "include_proc_metrics": false
      }
    }
  },
  "components": {
    "objectstore": {
      "type": "storage",
      "name": "objectstore",
      "enabled": true,
      "config": {
        "bucket_name": "AGENT_CONTENT"
      }
    },
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "ENTITY",
                "subjects": [
                  "entity.>"
                ]
              },
              "description": "Semantic entity events",
              "name": "entity_stream"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-write"
              },
              "description": "Entity state KV bucket",
              "name": "entity_states"
            }
          ]
        },
        "enable_hierarchy": true
      }
    },
    "rule": {
      "type": "processor",
      "name": "rule-processor",
      "enabled": true,
      "config": {
        "pack_id": "agentic-rules",
        "entity_watch_buckets": {"ENTITY_STATES": ["c360.*.*.*.*.*"]},
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.toolcall.proposed.>"
                ]
              },
              "description": "ADR-039 — proposed tool calls awaiting governance verdict",
              "name": "rule_toolcall_proposed_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "rule.triggered.alert"
                ]
              },
              "name": "rule_out"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.task.*"
                ]
              },
              "description": "Agent task triggers from rules",
              "name": "agent_task"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.toolcall.approved.*"
                ]
              },
              "description": "ADR-039 — approve verdicts to agentic-loop",
              "name": "toolcall_approved_out"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.toolcall.rejected.*"
                ]
              },
              "description": "ADR-039 — reject verdicts to agentic-loop",
              "name": "toolcall_rejected_out"
            }
          ]
        },
        "enable_graph_integration": true,
        "graph_event_subject_prefix": "sensor.processed",
        "inline_rules": [
          {
            "id": "governance-approve-all-audit",
            "type": "expression",
            "name": "ADR-039 audit-mode approve-all (E2E coverage)",
            "description": "Approves every proposed tool call so the e2e:agentic scenario can verify the governance flow fires (metric increments). Audit-mode means dispatch is not gated; this rule's verdict is observability only. Required `tool_name` condition filters out non-tool-call messages — the rule's default subscription is `>` (match-all), so this condition is what scopes it.",
            "enabled": true,
            "conditions": [
              {
                "field": "$message.tool_name",
                "operator": "ne",
                "value": "",
                "required": true
              },
              {
                "field": "$message.call_id",
                "operator": "ne",
                "value": "",
                "required": true
              }
            ],
            "logic": "and",
            "on_enter": [
              {
                "type": "approve",
                "subject": "agent.toolcall.approved.$message.call_id",
                "reason": "e2e governance audit approve-all for $message.tool_name"
              }
            ],
            "metadata": {
              "category": "governance",
              "tier": 0,
              "purpose": "e2e-coverage"
            }
          }
        ]
      }
    },
    "agentic-loop": {
      "type": "processor",
      "name": "agentic-loop",
      "enabled": true,
      "config": {
        "max_iterations": 5,
        "timeout": "30s",
        "stream_name": "AGENT",
        "loops_bucket": "AGENT_LOOPS",
        "tool_call_governance": {
          "mode": "audit",
          "timeout": "1s"
        },
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.task.*"
                ]
              },
              "description": "Agent task requests",
              "name": "agent.task",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.response.>"
                ]
              },
              "description": "Model responses",
              "name": "agent.response",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.result.>"
                ]
              },
              "description": "Tool execution results",
              "name": "tool.result",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.request.*"
                ]
              },
              "description": "Model requests",
              "name": "agent.request"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.execute.*"
                ]
              },
              "description": "Tool execution requests",
              "name": "tool.execute"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.complete.*"
                ]
              },
              "description": "Task completions",
              "name": "agent.complete"
            },
            {
              "config": {
                "bucket": "AGENT_LOOPS",
                "kind": "kv-write"
              },
              "description": "Loop state storage",
              "name": "loops"
            }
          ]
        }
      }
    },
    "agentic-model": {
      "type": "processor",
      "name": "agentic-model",
      "enabled": true,
      "config": {
        "timeout": "30s",
        "endpoints": {
          "mock": {
            "url": "http://mock-llm:8080/v1",
            "model": "mock-model"
          }
        },
        "retry": {
          "max_attempts": 3,
          "backoff": "exponential"
        },
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.request.>"
                ]
              },
              "description": "Agent request input",
              "name": "agent.request",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.response.*"
                ]
              },
              "description": "Agent response output",
              "name": "agent.response",
              "required": true
            }
          ]
        }
      }
    },
    "agentic-tools": {
      "type": "processor",
      "name": "agentic-tools",
      "enabled": true,
      "config": {
        "stream_name": "TOOL",
        "timeout": "10s",
        "allowed_tools": ["query_entity"],
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.execute.>"
                ]
              },
              "description": "Tool execution requests",
              "name": "tool.execute",
              "required": true
            },
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-read"
              },
              "description": "Entity state KV for graph queries",
              "name": "entity_states"
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.result.*"
                ]
              },
              "description": "Tool execution results",
              "name": "tool.result",
              "required": true
            }
          ]
        }
      }
    }
  }
}
