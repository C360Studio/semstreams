{
  "version": "1.1.0",
  "platform": {
    "org": "c360",
    "id": "semstreams-agentic",
    "type": "agentic-e2e",
    "region": "local",
    "instance_id": "agentic-001",
    "environment": "test"
  },
  "tier": "agentic",
  "nats": {
    "urls": ["nats://localhost:4222"]
  },
  "streams": {
    "AGENT": {
      "subjects": [
        "agent.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "ENTITY": {
      "subjects": [
        "entity.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "RULE": {
      "subjects": [
        "rule.>"
      ],
      "max_age": "24h",
      "max_bytes": 67108864,
      "discard": "old"
    },
    "TOOL": {
      "subjects": [
        "tool.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    }
  },
  "model_registry": {
    "endpoints": {
      "mock": {
        "provider": "openai",
        "url": "http://mock-llm:8080/v1",
        "model": "mock-model",
        "max_tokens": 4096,
        "supports_tools": true,
        "tool_format": "openai",
        "stream": true
      }
    },
    "defaults": {
      "model": "mock"
    }
  },
  "services": {
    "service-manager": {
      "name": "service-manager",
      "enabled": true,
      "config": {
        "http_port": 8080,
        "swagger_ui": true,
        "server_info": {
          "title": "SemStreams Agentic Tier - Agent Loop Testing",
          "description": "Agentic components with mock LLM for E2E testing",
          "version": "0.7.0"
        }
      }
    },
    "component-manager": {
      "name": "component-manager",
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "name": "metrics",
      "enabled": true,
      "config": {
        "port": 9090,
        "path": "/metrics",
        "include_go_metrics": true
      }
    },
    "message-logger": {
      "name": "message-logger",
      "enabled": true,
      "config": {
        "buffer_size": 10000,
        "monitor_subjects": ["agent.*", "tool.*"],
        "enable_kv_query": true,
        "log_level": "INFO"
      }
    },
    "log-forwarder": {
      "name": "log-forwarder",
      "enabled": true,
      "config": {
        "min_level": "DEBUG",
        "exclude_sources": []
      }
    },
    "metrics-forwarder": {
      "name": "metrics-forwarder",
      "enabled": true,
      "config": {
        "push_interval": "5s",
        "include_go_metrics": false,
        "include_proc_metrics": false
      }
    }
  },
  "components": {
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "entity_stream",
              "subject": "entity.>",
              "type": "jetstream",
              "description": "Semantic entity events"
            }
          ],
          "outputs": [
            {
              "name": "entity_states",
              "subject": "ENTITY_STATES",
              "type": "kv-write",
              "description": "Entity state KV bucket"
            }
          ]
        },
        "enable_hierarchy": true
      }
    },
    "rule": {
      "type": "processor",
      "name": "rule-processor",
      "enabled": true,
      "config": {
        "pack_id": "agentic-rules",
        "entity_watch_buckets": {"ENTITY_STATES": ["c360.*.*.*.*.*"]},
        "ports": {
          "inputs": [
            {
              "name": "rule_toolcall_proposed_in",
              "subject": "agent.toolcall.proposed.>",
              "type": "jetstream",
              "stream_name": "AGENT",
              "description": "ADR-039 — proposed tool calls awaiting governance verdict"
            }
          ],
          "outputs": [
            {
              "name": "rule_out",
              "subject": "rule.triggered.alert",
              "type": "jetstream"
            },
            {
              "name": "agent_task",
              "subject": "agent.task.*",
              "type": "jetstream",
              "stream_name": "AGENT",
              "description": "Agent task triggers from rules"
            },
            {
              "name": "toolcall_approved_out",
              "subject": "agent.toolcall.approved.*",
              "type": "jetstream",
              "stream_name": "AGENT",
              "description": "ADR-039 — approve verdicts to agentic-loop"
            },
            {
              "name": "toolcall_rejected_out",
              "subject": "agent.toolcall.rejected.*",
              "type": "jetstream",
              "stream_name": "AGENT",
              "description": "ADR-039 — reject verdicts to agentic-loop"
            }
          ]
        },
        "enable_graph_integration": true,
        "graph_event_subject_prefix": "sensor.processed",
        "inline_rules": [
          {
            "id": "governance-approve-all-audit",
            "type": "expression",
            "name": "ADR-039 audit-mode approve-all (E2E coverage)",
            "description": "Approves every proposed tool call so the e2e:agentic scenario can verify the governance flow fires (metric increments). Audit-mode means dispatch is not gated; this rule's verdict is observability only. Required `tool_name` condition filters out non-tool-call messages — the rule's default subscription is `>` (match-all), so this condition is what scopes it.",
            "enabled": true,
            "conditions": [
              {
                "field": "$message.tool_name",
                "operator": "ne",
                "value": "",
                "required": true
              },
              {
                "field": "$message.call_id",
                "operator": "ne",
                "value": "",
                "required": true
              }
            ],
            "logic": "and",
            "on_enter": [
              {
                "type": "approve",
                "subject": "agent.toolcall.approved.$message.call_id",
                "reason": "e2e governance audit approve-all for $message.tool_name"
              }
            ],
            "metadata": {
              "category": "governance",
              "tier": 0,
              "purpose": "e2e-coverage"
            }
          }
        ]
      }
    },
    "agentic-loop": {
      "type": "processor",
      "name": "agentic-loop",
      "enabled": true,
      "config": {
        "max_iterations": 5,
        "timeout": "30s",
        "stream_name": "AGENT",
        "loops_bucket": "AGENT_LOOPS",
        "tool_call_governance": {
          "mode": "audit",
          "timeout": "1s"
        },
        "ports": {
          "inputs": [
            {
              "name": "agent.task",
              "type": "jetstream",
              "subject": "agent.task.*",
              "stream_name": "AGENT",
              "required": true,
              "description": "Agent task requests"
            },
            {
              "name": "agent.response",
              "type": "jetstream",
              "subject": "agent.response.>",
              "stream_name": "AGENT",
              "required": true,
              "description": "Model responses"
            },
            {
              "name": "tool.result",
              "type": "jetstream",
              "subject": "tool.result.>",
              "stream_name": "TOOL",
              "required": true,
              "description": "Tool execution results"
            }
          ],
          "outputs": [
            {
              "name": "agent.request",
              "type": "jetstream",
              "subject": "agent.request.*",
              "stream_name": "AGENT",
              "description": "Model requests"
            },
            {
              "name": "tool.execute",
              "type": "jetstream",
              "subject": "tool.execute.*",
              "stream_name": "TOOL",
              "description": "Tool execution requests"
            },
            {
              "name": "agent.complete",
              "type": "jetstream",
              "subject": "agent.complete.*",
              "stream_name": "AGENT",
              "description": "Task completions"
            }
          ],
          "kv_write": [
            {
              "name": "loops",
              "type": "kv-write",
              "bucket": "AGENT_LOOPS",
              "description": "Loop state storage"
            },
            {
              "name": "trajectories",
              "type": "kv-write",
              "bucket": "AGENT_TRAJECTORIES",
              "description": "Trajectory storage"
            }
          ]
        }
      }
    },
    "agentic-model": {
      "type": "processor",
      "name": "agentic-model",
      "enabled": true,
      "config": {
        "stream_name": "AGENT",
        "timeout": "30s",
        "endpoints": {
          "mock": {
            "url": "http://mock-llm:8080/v1",
            "model": "mock-model"
          }
        },
        "retry": {
          "max_attempts": 3,
          "backoff": "exponential"
        },
        "ports": {
          "inputs": [
            {
              "name": "agent.request",
              "type": "jetstream",
              "subject": "agent.request.>",
              "stream_name": "AGENT",
              "required": true,
              "description": "Agent request input"
            }
          ],
          "outputs": [
            {
              "name": "agent.response",
              "type": "jetstream",
              "subject": "agent.response.*",
              "stream_name": "AGENT",
              "required": true,
              "description": "Agent response output"
            }
          ]
        }
      }
    },
    "agentic-tools": {
      "type": "processor",
      "name": "agentic-tools",
      "enabled": true,
      "config": {
        "stream_name": "TOOL",
        "timeout": "10s",
        "allowed_tools": ["query_entity"],
        "ports": {
          "inputs": [
            {
              "name": "tool.execute",
              "type": "jetstream",
              "subject": "tool.execute.>",
              "stream_name": "TOOL",
              "required": true,
              "description": "Tool execution requests"
            }
          ],
          "outputs": [
            {
              "name": "tool.result",
              "type": "jetstream",
              "subject": "tool.result.*",
              "stream_name": "TOOL",
              "required": true,
              "description": "Tool execution results"
            }
          ],
          "kv_read": [
            {
              "name": "entity_states",
              "type": "kv-read",
              "bucket": "ENTITY_STATES",
              "description": "Entity state KV for graph queries"
            }
          ]
        }
      }
    }
  }
}
