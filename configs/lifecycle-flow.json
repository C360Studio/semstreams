{
  "version": "1.1.1",
  "platform": {
    "org": "c360",
    "id": "semstreams-lifecycle",
    "type": "lifecycle-e2e",
    "region": "local",
    "environment": "test"
  },
  "tier": "lifecycle",
  "nats": {
    "urls": ["nats://localhost:4222"]
  },
  "services": {
    "service-manager": {
      "enabled": true,
      "config": {
        "http_port": 8080,
        "swagger_ui": true,
        "server_info": {
          "title": "SemStreams Lifecycle Tier — Mission Workflow E2E",
          "description": "ADR-047 Lifecycle harness + lifecycle-gateway + rule-driven transitions",
          "version": "0.1.0"
        }
      }
    },
    "component-manager": {
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "enabled": true,
      "config": {
        "port": 9090,
        "path": "/metrics"
      }
    },
    "message-logger": {
      "enabled": true,
      "config": {
        "monitor_subjects": ["mission.*", "raw.mission.*"]
      }
    },
    "log-forwarder": {
      "enabled": true,
      "config": {
        "min_level": "INFO"
      }
    }
  },
  "streams": {
    "MISSION": {
      "subjects": [
        "mission.>"
      ],
      "max_age": "24h",
      "max_bytes": 67108864,
      "discard": "old"
    },
    "RAW": {
      "subjects": [
        "raw.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    }
  },
  "components": {
    "udp": {
      "type": "input",
      "name": "udp",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.mission.command"
                ]
              },
              "name": "nats_output"
            }
          ]
        },
        "bind": "0.0.0.0",
        "port": 14550,
        "buffer_size": 65536
      }
    },
    "mission-command": {
      "type": "processor",
      "name": "mission-command",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats",
                "subject": "raw.mission.command"
              },
              "name": "command_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "mission.command.v1"
                },
                "kind": "nats",
                "subject": "mission.processed.entity"
              },
              "name": "command_out"
            }
          ]
        }
      }
    },
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "interface": {
                  "type": "mission.command.v1"
                },
                "kind": "jetstream",
                "stream_name": "MISSION",
                "subjects": [
                  "mission.processed.entity"
                ]
              },
              "description": "Mission command Graphables to land in ENTITY_STATES",
              "name": "mission_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-write"
              },
              "name": "entity_states"
            }
          ]
        },
        "enable_hierarchy": false
      }
    },
    "rule": {
      "type": "processor",
      "name": "rule-processor",
      "enabled": true,
      "config": {
        "pack_id": "lifecycle-flow-rules",
        "enable_graph_integration": true,
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            }
          ]
        },
        "entity_watch_buckets": {"ENTITY_STATES": ["*.*.gcs.lifecycle.mission.*"]},
        "rules_files": ["/app/configs/rules/lifecycle/01-mission-launch.json"],
        "buffer_window_size": "10m",
        "alert_cooldown_period": "2m"
      }
    },
    "lifecycle-gateway": {
      "type": "gateway",
      "name": "lifecycle-gateway",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            }
          ]
        },
        "path_prefix": "workflows",
        "enable_websocket": true,
        "allowed_origins": ["http://localhost", "http://localhost:38080"]
      }
    }
  }
}
