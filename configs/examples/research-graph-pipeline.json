{
  "_doc": [
    "Reference flow for the ADR-045 graph-search-decompose-and-fusion pattern.",
    "",
    "ADR-075 composes the five research-graph-* components, research payloads,",
    "research_graph/read_loop_result tools, and the R0-R6 rule pack as one atomic",
    "framework capability. Operators may tune endpoints and bounded stage settings,",
    "but removing or substituting a required capability member fails boot validation.",
    "",
    "Components composed (alphabetical):",
    "  agentic-dispatch    - parent-loop dispatch (user message -> agent.task)",
    "  agentic-loop        - agent loop runtime (TaskMessage -> tool calls -> completion)",
    "  agentic-model       - LLM endpoint adapter (uses model_registry above)",
    "  agentic-tools       - tool dispatch (research_graph is registered here)",
    "  graph-ingest        - triple mutations -> ENTITY_STATES",
    "  graph-query         - graph query / classifier backend",
    "  research-graph-classify    - ADR-045 PR 2 nl_classify component",
    "  research-graph-route       - ADR-045 PR 3 route_search component (LLM)",
    "  research-graph-execute     - ADR-045 PR 4 execute_subqueries component",
    "  research-graph-assess      - ADR-045 PR 5 assess_sufficiency component (LLM)",
    "  research-graph-synthesize  - ADR-045 PR 5 synthesize_answer component (LLM)",
    "  rule-processor      - loads R0-R6 rule pack and fires on ENTITY_STATES updates",
    "",
    "model_registry, platform, and NATS endpoints carry CHANGE_ME placeholders.",
    "Replace with deployment-specific values before running.",
    "",
    "See:",
    "  docs/adr/045-graph-search-rule-chain.md - architecture",
    "  docs/operations/22-adr045-phase1-plan.md - PR 6 plan (this file)",
    "  configs/rules/research-graph/README.md - rule pack notes"
  ],
  "version": "1.0.1",
  "platform": {
    "org": "CHANGE_ME",
    "id": "research-graph-pipeline",
    "type": "agentic",
    "environment": "production"
  },
  "tier": "agentic",
  "nats": {
    "urls": ["nats://localhost:4222"]
  },
  "model_registry": {
    "endpoints": {
      "general": {
        "provider": "openai",
        "url": "CHANGE_ME",
        "model": "CHANGE_ME",
        "max_tokens": 8192,
        "supports_tools": true,
        "tool_format": "openai"
      }
    },
    "defaults": {
      "model": "general"
    },
    "capabilities": {
      "general": { "preferred": ["general"] },
      "research_routing": { "preferred": ["general"] },
      "research_assessment": { "preferred": ["general"] },
      "research_synthesis": { "preferred": ["general"] }
    }
  },
  "services": {
    "service-manager": {
      "enabled": true,
      "config": {
        "http_port": 8080,
        "server_info": {
          "title": "SemStreams ADR-045 Research-Graph Pipeline",
          "description": "Reference flow exercising the rule-driven graph search chain (R0-R6).",
          "version": "0.1.0"
        }
      }
    },
    "component-manager": {
      "enabled": true,
      "config": {}
    }
  },
  "streams": {
    "AGENT": {
      "subjects": [
        "agent.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "TOOL": {
      "subjects": [
        "tool.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "USER": {
      "subjects": [
        "user.>"
      ],
      "storage": "file",
      "max_age": "1h",
      "max_bytes": 16777216,
      "discard": "old"
    }
  },
  "components": {
    "objectstore": {
      "type": "storage",
      "name": "objectstore",
      "enabled": true,
      "config": {
        "bucket_name": "AGENT_CONTENT"
      }
    },
    "agentic-dispatch": {
      "type": "processor",
      "name": "agentic-dispatch",
      "enabled": true,
      "config": {
        "default_role": "general",
        "default_tools": ["research_graph", "read_loop_result"],
        "auto_continue": false,
        "stream_name": "USER",
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "USER",
                "subjects": [
                  "user.message.>"
                ]
              },
              "name": "user.message",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.complete.*"
                ]
              },
              "name": "agent.complete",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.task.*"
                ]
              },
              "name": "agent.task"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "USER",
                "subjects": [
                  "user.response.*"
                ]
              },
              "name": "user.response"
            }
          ]
        }
      }
    },
    "agentic-loop": {
      "type": "processor",
      "name": "agentic-loop",
      "enabled": true,
      "config": {
        "max_iterations": 5,
        "timeout": "120s",
        "stream_name": "AGENT",
        "loops_bucket": "AGENT_LOOPS",
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.task.*"
                ]
              },
              "name": "agent.task",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.response.>"
                ]
              },
              "name": "agent.response",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.result.>"
                ]
              },
              "name": "tool.result",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.request.*"
                ]
              },
              "name": "agent.request"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.execute.*"
                ]
              },
              "name": "tool.execute"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.complete.*"
                ]
              },
              "name": "agent.complete"
            },
            {
              "config": {
                "bucket": "AGENT_LOOPS",
                "kind": "kv-write"
              },
              "name": "loops"
            }
          ]
        }
      }
    },
    "agentic-model": {
      "type": "processor",
      "name": "agentic-model",
      "enabled": true,
      "config": {
        "timeout": "120s",
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.request.>"
                ]
              },
              "name": "agent.request",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.response.*"
                ]
              },
              "name": "agent.response",
              "required": true
            }
          ]
        }
      }
    },
    "agentic-tools": {
      "type": "processor",
      "name": "agentic-tools",
      "enabled": true,
      "config": {
        "stream_name": "TOOL",
        "timeout": "60s",
        "allowed_tools": ["research_graph", "read_loop_result", "decide"],
        "loops_bucket": "AGENT_LOOPS",
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.execute.>"
                ]
              },
              "name": "tool.execute",
              "required": true
            },
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-read"
              },
              "name": "entity_states"
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.result.*"
                ]
              },
              "name": "tool.result",
              "required": true
            }
          ]
        }
      }
    },
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "enable_hierarchy": true,
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-write"
              },
              "name": "entity_states"
            }
          ]
        }
      }
    },
    "graph-query": {
      "type": "processor",
      "name": "graph-query",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats-request",
                "subject": "graph.query.*",
                "interface": {"type": "graph.query", "version": "v1"}
              },
              "name": "graph_queries",
              "required": true
            }
          ]
        }
      }
    },
    "research-graph-classify": {
      "type": "processor",
      "name": "research-graph-classify",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats",
                "subject": "component.nl_classify.>"
              },
              "name": "classify_trigger",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "interface": {"type": "graph.query", "version": "v1"},
                "kind": "nats-request",
                "subject": "graph.query.searchGraph"
              },
              "name": "searchGraph",
              "required": true
            }
          ]
        }
      }
    },
    "research-graph-route": {
      "type": "processor",
      "name": "research-graph-route",
      "enabled": true,
      "config": {
        "model_capability": "research_routing",
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats",
                "subject": "component.route_search.>"
              },
              "name": "route_trigger",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            }
          ]
        }
      }
    },
    "research-graph-execute": {
      "type": "processor",
      "name": "research-graph-execute",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats",
                "subject": "component.execute_subqueries.>"
              },
              "name": "execute_trigger",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "interface": {"type": "graph.query", "version": "v1"},
                "kind": "nats-request",
                "subject": "graph.query.batch"
              },
              "name": "batch",
              "required": true
            },
            {
              "config": {
                "interface": {"type": "graph.query", "version": "v1"},
                "kind": "nats-request",
                "subject": "graph.query.relationships"
              },
              "name": "relationships",
              "required": true
            },
            {
              "config": {
                "interface": {"type": "graph.query", "version": "v1"},
                "kind": "nats-request",
                "subject": "graph.query.temporal"
              },
              "name": "temporal",
              "required": true
            },
            {
              "config": {
                "interface": {"type": "graph.query", "version": "v1"},
                "kind": "nats-request",
                "subject": "graph.query.searchGraph"
              },
              "name": "searchGraph",
              "required": true
            }
          ]
        }
      }
    },
    "research-graph-assess": {
      "type": "processor",
      "name": "research-graph-assess",
      "enabled": true,
      "config": {
        "model_capability": "research_assessment",
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats",
                "subject": "component.assess_sufficiency.>"
              },
              "name": "assess_trigger",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            }
          ]
        }
      }
    },
    "research-graph-synthesize": {
      "type": "processor",
      "name": "research-graph-synthesize",
      "enabled": true,
      "config": {
        "model_capability": "research_synthesis",
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats",
                "subject": "component.synthesize_answer.>"
              },
              "name": "synthesize_trigger",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            }
          ]
        }
      }
    },
    "rule-processor": {
      "type": "processor",
      "name": "rule-processor",
      "enabled": true,
      "config": {
        "pack_id": "research-graph-example-rules",
        "rules_files": [
          "/app/configs/rules/research-graph/00-kickoff-classify.json",
          "/app/configs/rules/research-graph/01-classify-routes.json",
          "/app/configs/rules/research-graph/02-route-decision-dispatch.json",
          "/app/configs/rules/research-graph/03-execute-assesses.json",
          "/app/configs/rules/research-graph/04-assess-dispatch.json",
          "/app/configs/rules/research-graph/05-continuation.json"
        ],
        "enable_graph_integration": true,
        "entity_watch_buckets": {
          "ENTITY_STATES": ["*.*.*.*.*.*"]
        },
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "name": "entity_states"
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "nats",
                "subject": "component.*"
              },
              "description": "Per-stage dispatch published by R0-R4",
              "name": "component.dispatch"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.task.*"
                ]
              },
              "description": "R6 continuation publishes back to parent role",
              "name": "agent.task"
            },
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "description": "Canonical graph mutation request/reply interface",
              "name": "graph_mutations",
              "required": true
            }
          ]
        }
      }
    }
  }
}
