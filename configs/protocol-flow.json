{
  "version": "1.0.1",
  "platform": {
    "org": "c360",
    "id": "streamkit-pure",
    "type": "flow-orchestration",
    "region": "local",
    "instance_id": "streamkit-001",
    "environment": "development"
  },
  "nats": {
    "urls": ["nats://localhost:4222"]
  },
  "services": {
    "component-manager": {
      "name": "component-manager",
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "name": "metrics",
      "enabled": true,
      "config": {
        "port": 9090,
        "path": "/metrics",
        "include_go_metrics": true
      }
    },
    "message-logger": {
      "name": "message-logger",
      "enabled": true,
      "config": {
        "buffer_size": 10000,
        "monitor_subjects": ["*", "graph.mutation.>"],
        "sample_rate": 1,
        "enable_kv_query": true,
        "log_level": "INFO"
      }
    },
    "flow-builder": {
      "name": "flow-builder",
      "enabled": true,
      "config": {}
    },
    "log-forwarder": {
      "name": "log-forwarder",
      "enabled": true,
      "config": {
        "min_level": "DEBUG",
        "exclude_sources": ["flow-service.websocket"]
      }
    },
    "metrics-forwarder": {
      "name": "metrics-forwarder",
      "enabled": true,
      "config": {
        "push_interval": "5s",
        "include_go_metrics": false,
        "include_proc_metrics": false
      }
    }
  },
  "streams": {
    "FILTERED": {
      "subjects": [
        "filtered.>"
      ],
      "max_age": "24h",
      "max_bytes": 67108864,
      "discard": "old"
    },
    "GENERIC": {
      "subjects": [
        "generic.>"
      ],
      "max_age": "24h",
      "max_bytes": 67108864,
      "discard": "old"
    },
    "MAPPED": {
      "subjects": [
        "mapped.>"
      ],
      "max_age": "24h",
      "max_bytes": 67108864,
      "discard": "old"
    },
    "RAW": {
      "subjects": [
        "raw.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    }
  },
  "components": {
    "udp": {
      "type": "input",
      "name": "udp",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.udp.messages"
                ]
              },
              "name": "udp_out"
            }
          ]
        },
        "bind": "0.0.0.0",
        "port": 14550,
        "buffer_size": 65536
      }
    },
    "json_generic": {
      "type": "processor",
      "name": "json_generic",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.udp.messages"
                ]
              },
              "description": "Plain JSON from UDP",
              "name": "generic_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "core .json.v1"
                },
                "kind": "jetstream",
                "subjects": [
                  "generic.messages"
                ]
              },
              "description": "GenericJSON wrapped messages",
              "name": "generic_out"
            }
          ]
        }
      }
    },
    "json_filter": {
      "type": "processor",
      "name": "json_filter",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "core .json.v1"
                },
                "kind": "jetstream",
                "subjects": [
                  "generic.messages"
                ]
              },
              "name": "filter_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "filtered.messages"
                ]
              },
              "name": "filter_out"
            }
          ]
        },
        "criteria": {}
      }
    },
    "json_map": {
      "type": "processor",
      "name": "json_map",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "filtered.messages"
                ]
              },
              "name": "map_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "mapped.messages"
                ]
              },
              "name": "map_out"
            }
          ]
        },
        "mappings": []
      }
    },
    "file": {
      "type": "output",
      "name": "file",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "core .json.v1"
                },
                "kind": "jetstream",
                "subjects": [
                  "mapped.messages"
                ]
              },
              "name": "file_in"
            }
          ],
          "outputs": []
        },
        "directory": "/tmp",
        "file_prefix": "streamkit-test",
        "format": "jsonl"
      }
    },
    "httppost": {
      "type": "output",
      "name": "httppost",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "core .json.v1"
                },
                "kind": "jetstream",
                "subjects": [
                  "mapped.messages"
                ]
              },
              "name": "http_in"
            }
          ],
          "outputs": []
        },
        "url": "http://localhost:9999/webhook",
        "retry_max": 3
      }
    },
    "websocket": {
      "type": "output",
      "name": "websocket",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.udp.messages"
                ]
              },
              "name": "ws_in"
            }
          ],
          "outputs": []
        },
        "http_port": 8082,
        "path": "/ws"
      }
    },
    "objectstore": {
      "type": "storage",
      "name": "objectstore",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "core .json.v1"
                },
                "kind": "jetstream",
                "subjects": [
                  "mapped.messages"
                ]
              },
              "name": "store_in"
            }
          ],
          "outputs": []
        },
        "bucket_name": "streamkit_test_store",
        "data_cache": {
          "enabled": true,
          "strategy": "lru",
          "max_size": 1000
        }
      }
    },
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "kind": "nats",
                "subject": "_e2e.core.graph.unused"
              },
              "name": "unused_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-write"
              },
              "name": "entity_states"
            }
          ]
        },
        "enable_hierarchy": false
      }
    },
    "graph-index": {
      "type": "processor",
      "name": "graph-index",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "name": "entity_watch"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "OUTGOING_INDEX",
                "kind": "kv-write"
              },
              "name": "outgoing_index"
            },
            {
              "config": {
                "bucket": "INCOMING_INDEX",
                "kind": "kv-write"
              },
              "name": "incoming_index"
            },
            {
              "config": {
                "bucket": "ALIAS_INDEX",
                "kind": "kv-write"
              },
              "name": "alias_index"
            },
            {
              "config": {
                "bucket": "PREDICATE_INDEX",
                "kind": "kv-write"
              },
              "name": "predicate_index"
            }
          ]
        },
        "workers": 2,
        "batch_size": 10
      }
    },
    "graph-query": {
      "type": "processor",
      "name": "graph-query",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats-request",
                "subject": "graph.query.>"
              },
              "name": "query_requests"
            }
          ],
          "outputs": []
        },
        "request_timeout": "30s",
        "max_traversal_depth": 5,
        "max_traversal_nodes": 100
      }
    },
    "graph-gateway": {
      "type": "gateway",
      "name": "graph-gateway",
      "enabled": true,
      "config": {
      "ports": {
        "outputs": [
          {
            "config": {
              "kind": "nats-request",
              "subject": "graph.query.*"
            },
            "name": "graph_queries",
            "required": true
          },
          {
            "config": {
              "kind": "nats-request",
              "subject": "graph.index.query.*"
            },
            "name": "graph_index_queries",
            "required": true
          },
          {
            "config": {
              "kind": "nats-request",
              "subject": "agentic.query.*"
            },
            "name": "agentic_queries",
            "required": true
          }
        ]
      },
        "graphql_path": "/graphql",
        "enable_playground": false
      }
    }
  }
}
