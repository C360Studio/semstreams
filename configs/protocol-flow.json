{
  "version": "1.0.1",
  "platform": {
    "org": "c360",
    "id": "streamkit-pure",
    "type": "flow-orchestration",
    "region": "local",
    "instance_id": "streamkit-001",
    "environment": "development"
  },
  "nats": {
    "urls": ["nats://localhost:4222"]
  },
  "services": {
    "component-manager": {
      "name": "component-manager",
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "name": "metrics",
      "enabled": true,
      "config": {
        "port": 9090,
        "path": "/metrics",
        "include_go_metrics": true
      }
    },
    "message-logger": {
      "name": "message-logger",
      "enabled": true,
      "config": {
        "buffer_size": 10000,
        "monitor_subjects": ["*", "graph.mutation.>"],
        "sample_rate": 1,
        "enable_kv_query": true,
        "log_level": "INFO"
      }
    },
    "flow-builder": {
      "name": "flow-builder",
      "enabled": true,
      "config": {}
    },
    "log-forwarder": {
      "name": "log-forwarder",
      "enabled": true,
      "config": {
        "min_level": "DEBUG",
        "exclude_sources": ["flow-service.websocket"]
      }
    },
    "metrics-forwarder": {
      "name": "metrics-forwarder",
      "enabled": true,
      "config": {
        "push_interval": "5s",
        "include_go_metrics": false,
        "include_proc_metrics": false
      }
    }
  },
  "streams": {
    "FILTERED": {
      "subjects": [
        "filtered.>"
      ],
      "max_age": "24h",
      "max_bytes": 67108864,
      "discard": "old"
    },
    "GENERIC": {
      "subjects": [
        "generic.>"
      ],
      "max_age": "24h",
      "max_bytes": 67108864,
      "discard": "old"
    },
    "MAPPED": {
      "subjects": [
        "mapped.>"
      ],
      "max_age": "24h",
      "max_bytes": 67108864,
      "discard": "old"
    },
    "RAW": {
      "subjects": [
        "raw.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    }
  },
  "components": {
    "udp": {
      "type": "input",
      "name": "udp",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "name": "udp_out",
              "subject": "raw.udp.messages",
              "type": "jetstream"
            }
          ]
        },
        "bind": "0.0.0.0",
        "port": 14550,
        "buffer_size": 65536
      }
    },
    "json_generic": {
      "type": "processor",
      "name": "json_generic",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "generic_in",
              "subject": "raw.udp.messages",
              "type": "jetstream",
              "description": "Plain JSON from UDP"
            }
          ],
          "outputs": [
            {
              "name": "generic_out",
              "subject": "generic.messages",
              "type": "jetstream",
              "interface": "core .json.v1",
              "description": "GenericJSON wrapped messages"
            }
          ]
        }
      }
    },
    "json_filter": {
      "type": "processor",
      "name": "json_filter",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "filter_in",
              "subject": "generic.messages",
              "type": "jetstream",
              "interface": "core .json.v1"
            }
          ],
          "outputs": [
            {
              "name": "filter_out",
              "subject": "filtered.messages",
              "type": "jetstream"
            }
          ]
        },
        "criteria": {}
      }
    },
    "json_map": {
      "type": "processor",
      "name": "json_map",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "map_in",
              "subject": "filtered.messages",
              "type": "jetstream"
            }
          ],
          "outputs": [
            {
              "name": "map_out",
              "subject": "mapped.messages",
              "type": "jetstream"
            }
          ]
        },
        "mappings": []
      }
    },
    "file": {
      "type": "output",
      "name": "file",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "file_in",
              "subject": "mapped.messages",
              "type": "jetstream",
              "interface": "core .json.v1"
            }
          ],
          "outputs": []
        },
        "directory": "/tmp",
        "file_prefix": "streamkit-test",
        "format": "jsonl"
      }
    },
    "httppost": {
      "type": "output",
      "name": "httppost",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "http_in",
              "subject": "mapped.messages",
              "type": "jetstream",
              "interface": "core .json.v1"
            }
          ],
          "outputs": []
        },
        "url": "http://localhost:9999/webhook",
        "retry_max": 3
      }
    },
    "websocket": {
      "type": "output",
      "name": "websocket",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "ws_in",
              "subject": "raw.udp.messages",
              "type": "jetstream"
            }
          ],
          "outputs": []
        },
        "http_port": 8082,
        "path": "/ws"
      }
    },
    "objectstore": {
      "type": "storage",
      "name": "objectstore",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "store_in",
              "subject": "mapped.messages",
              "type": "jetstream",
              "interface": "core .json.v1"
            }
          ],
          "outputs": []
        },
        "bucket_name": "streamkit_test_store",
        "data_cache": {
          "enabled": true,
          "strategy": "lru",
          "max_size": 1000
        }
      }
    },
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "graph_mutations",
              "subject": "graph.mutation.>",
              "type": "nats-request",
              "interface": "semstreams.graph.mutation",
              "required": true
            },
            {
              "name": "unused_in",
              "subject": "_e2e.core.graph.unused",
              "type": "nats"
            }
          ],
          "outputs": [
            {
              "name": "entity_states",
              "subject": "ENTITY_STATES",
              "type": "kv-write"
            }
          ]
        },
        "enable_hierarchy": false
      }
    },
    "graph-index": {
      "type": "processor",
      "name": "graph-index",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "entity_watch",
              "subject": "ENTITY_STATES",
              "type": "kv-watch"
            }
          ],
          "outputs": [
            {"name": "outgoing_index", "subject": "OUTGOING_INDEX", "type": "kv"},
            {"name": "incoming_index", "subject": "INCOMING_INDEX", "type": "kv"},
            {"name": "alias_index", "subject": "ALIAS_INDEX", "type": "kv"},
            {"name": "predicate_index", "subject": "PREDICATE_INDEX", "type": "kv"}
          ]
        },
        "workers": 2,
        "batch_size": 10
      }
    },
    "graph-query": {
      "type": "processor",
      "name": "graph-query",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "query_requests",
              "subject": "graph.query.>",
              "type": "nats-request"
            }
          ],
          "outputs": []
        },
        "request_timeout": "30s",
        "max_traversal_depth": 5,
        "max_traversal_nodes": 100
      }
    },
    "graph-gateway": {
      "type": "gateway",
      "name": "graph-gateway",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {"name": "http", "subject": ":8084", "type": "http"}
          ],
          "outputs": [
            {"name": "queries", "subject": "graph.query.*", "type": "nats-request"}
          ]
        },
        "graphql_path": "/graphql",
        "enable_playground": false
      }
    }
  }
}
