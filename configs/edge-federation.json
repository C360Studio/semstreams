{
  "version": "1.0.1",
  "platform": {
    "org": "c360",
    "id": "streamkit-edge",
    "type": "edge-gateway",
    "region": "edge",
    "instance_id": "edge-001",
    "environment": "development"
  },
  "nats": {
    "urls": ["nats://localhost:4222"]
  },
  "services": {
    "component-manager": {
      "name": "component-manager",
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "name": "metrics",
      "enabled": true,
      "config": {
        "port": 9091,
        "path": "/metrics",
        "include_go_metrics": true
      }
    },
    "log-forwarder": {
      "name": "log-forwarder",
      "enabled": true,
      "config": {
        "min_level": "DEBUG",
        "exclude_sources": ["flow-service.websocket"]
      }
    },
    "metrics-forwarder": {
      "name": "metrics-forwarder",
      "enabled": true,
      "config": {
        "push_interval": "5s",
        "include_go_metrics": false,
        "include_proc_metrics": false
      }
    }
  },
  "streams": {
    "EDGE": {
      "subjects": [
        "edge.>"
      ],
      "max_age": "24h",
      "max_bytes": 67108864,
      "discard": "old"
    }
  },
  "components": {
    "udp": {
      "type": "input",
      "name": "udp",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "edge.raw.data"
                ]
              },
              "description": "Raw UDP data from edge devices",
              "name": "udp_out"
            }
          ]
        },
        "bind": "0.0.0.0",
        "port": 14550,
        "buffer_size": 65536
      }
    },
    "json_filter": {
      "type": "processor",
      "name": "json_filter",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "EDGE",
                "subjects": [
                  "edge.raw.data"
                ]
              },
              "name": "filter_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "edge.filtered.data"
                ]
              },
              "description": "Filtered data ready for federation",
              "name": "filter_out"
            }
          ]
        },
        "criteria": {}
      }
    },
    "websocket": {
      "type": "output",
      "name": "websocket",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "EDGE",
                "subjects": [
                  "edge.filtered.data"
                ]
              },
              "name": "ws_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "host": "0.0.0.0",
                "kind": "network",
                "port": 8082,
                "protocol": "http"
              },
              "description": "WebSocket server endpoint for federation",
              "name": "websocket_server"
            }
          ]
        },
        "delivery_mode": "at-least-once",
        "ack_timeout": "5s"
      }
    }
  }
}
