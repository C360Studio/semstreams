{
  "version": "1.0.1",
  "platform": {
    "org": "c360",
    "id": "streamkit-cloud",
    "type": "cloud-hub",
    "region": "cloud",
    "instance_id": "cloud-001",
    "environment": "development"
  },
  "nats": {
    "urls": ["nats://localhost:4223"]
  },
  "services": {
    "component-manager": {
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "enabled": true,
      "config": {
        "port": 9092,
        "path": "/metrics"
      }
    },
    "log-forwarder": {
      "enabled": true,
      "config": {
        "min_level": "DEBUG",
        "exclude_sources": ["flow-service.websocket"]
      }
    },
    "metrics-forwarder": {
      "enabled": true,
      "config": {
        "push_interval": "5s",
        "include_go_metrics": false,
        "include_proc_metrics": false
      }
    }
  },
  "streams": {
    "CLOUD": {
      "subjects": [
        "cloud.>"
      ],
      "max_age": "24h",
      "max_bytes": 67108864,
      "discard": "old"
    }
  },
  "components": {
    "websocket_input": {
      "type": "input",
      "name": "websocket_input",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "cloud.federated.data"
                ]
              },
              "description": "Data received from edge via WebSocket",
              "name": "ws_data"
            }
          ]
        },
        "mode": "client",
        "client": {
          "url": "ws://edge:8082/stream",
          "reconnect": {
            "enabled": true,
            "max_retries": 10,
            "initial_interval": "1s",
            "max_interval": "60s",
            "multiplier": 2.0
          }
        },
        "backpressure": {
          "enabled": true,
          "queue_size": 1000,
          "on_full": "drop_oldest"
        }
      }
    },
    "file": {
      "type": "output",
      "name": "file",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "CLOUD",
                "subjects": [
                  "cloud.federated.data"
                ]
              },
              "name": "file_in"
            }
          ],
          "outputs": []
        },
        "directory": "/tmp",
        "file_prefix": "cloud-federated",
        "format": "jsonl"
      }
    }
  }
}
