{
  "version": "1.1.0",
  "platform": {
    "org": "example",
    "id": "graph-backend",
    "type": "graph-backend",
    "region": "local",
    "instance_id": "backend-001",
    "environment": "development"
  },
  "tier": "rules",
  "nats": {
    "urls": ["nats://localhost:4222"]
  },
  "services": {
    "service-manager": {
      "enabled": true,
      "config": {
        "http_port": 8080,
        "swagger_ui": true,
        "server_info": {
          "title": "SemStreams Graph Backend",
          "description": "Slim graph-only instance — mutation handlers + index responders + query responder, no source-data pipeline.",
          "version": "0.1.0"
        }
      }
    },
    "component-manager": {
      "enabled": true,
      "config": {}
    }
  },
  "components": {
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-write"
              },
              "name": "entity_states"
            }
          ]
        },
        "enable_hierarchy": true
      }
    },
    "graph-index": {
      "type": "processor",
      "name": "graph-index",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "name": "entity_watch"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "OUTGOING_INDEX",
                "kind": "kv-write"
              },
              "name": "outgoing_index"
            },
            {
              "config": {
                "bucket": "INCOMING_INDEX",
                "kind": "kv-write"
              },
              "name": "incoming_index"
            },
            {
              "config": {
                "bucket": "ALIAS_INDEX",
                "kind": "kv-write"
              },
              "name": "alias_index"
            },
            {
              "config": {
                "bucket": "PREDICATE_INDEX",
                "kind": "kv-write"
              },
              "name": "predicate_index"
            }
          ]
        },
        "workers": 2,
        "batch_size": 50
      }
    },
    "graph-index-spatial": {
      "type": "processor",
      "name": "graph-index-spatial",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "name": "entity_watch"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "SPATIAL_INDEX",
                "kind": "kv-write"
              },
              "name": "spatial_index"
            }
          ]
        },
        "geohash_precision": 6,
        "workers": 1,
        "batch_size": 50
      }
    },
    "graph-index-temporal": {
      "type": "processor",
      "name": "graph-index-temporal",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "name": "entity_watch"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "TEMPORAL_INDEX",
                "kind": "kv-write"
              },
              "name": "temporal_index"
            }
          ]
        },
        "time_resolution": "hour",
        "workers": 1,
        "batch_size": 50
      }
    },
    "graph-query": {
      "type": "processor",
      "name": "graph-query",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats-request",
                "subject": "graph.query.>"
              },
              "name": "query_requests"
            }
          ],
          "outputs": []
        },
        "request_timeout": "30s",
        "max_traversal_depth": 5,
        "max_traversal_nodes": 100
      }
    }
  }
}
