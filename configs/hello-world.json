{
  "version": "1.1.0",
  "platform": {
    "org": "demo",
    "id": "hello-world",
    "type": "quickstart",
    "region": "local",
    "instance_id": "hello-001",
    "environment": "development"
  },
  "tier": "rules",
  "nats": {
    "urls": ["nats://localhost:4222"]
  },
  "services": {
    "service-manager": {
      "name": "service-manager",
      "enabled": true,
      "config": {
        "http_port": 8080,
        "swagger_ui": true,
        "server_info": {
          "title": "SemStreams Hello World",
          "description": "Quickstart example: UDP -> Graph -> GraphQL",
          "version": "0.1.0"
        }
      }
    },
    "component-manager": {
      "name": "component-manager",
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "name": "metrics",
      "enabled": true,
      "config": {
        "port": 9090,
        "path": "/metrics",
        "include_go_metrics": false
      }
    },
    "message-logger": {
      "name": "message-logger",
      "enabled": true,
      "config": {
        "buffer_size": 1000,
        "monitor_subjects": ["*"],
        "enable_kv_query": true,
        "log_level": "INFO"
      }
    },
    "log-forwarder": {
      "name": "log-forwarder",
      "enabled": true,
      "config": {
        "min_level": "INFO"
      }
    }
  },
  "streams": {
    "RAW": {
      "subjects": [
        "raw.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "SENSOR": {
      "subjects": [
        "sensor.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    }
  },
  "components": {
    "udp": {
      "type": "input",
      "name": "udp",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.sensor.udp"
                ]
              },
              "name": "udp_out"
            }
          ]
        },
        "bind": "0.0.0.0",
        "port": 14550,
        "buffer_size": 65536
      }
    },

    "iot_sensor": {
      "type": "processor",
      "name": "iot_sensor",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.sensor.>"
                ]
              },
              "name": "sensor_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "iot.sensor.v1"
                },
                "kind": "jetstream",
                "subjects": [
                  "sensor.processed.entity"
                ]
              },
              "name": "sensor_out"
            }
          ]
        },
        "org_id": "demo",
        "platform": "hello"
      }
    },

    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "interface": {
                  "type": "iot.sensor.v1"
                },
                "kind": "jetstream",
                "subjects": [
                  "sensor.processed.entity"
                ]
              },
              "name": "sensor_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-write"
              },
              "name": "entity_states"
            }
          ]
        },
        "enable_hierarchy": true
      }
    },

    "graph-index": {
      "type": "processor",
      "name": "graph-index",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "name": "entity_watch"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "OUTGOING_INDEX",
                "kind": "kv-write"
              },
              "name": "outgoing_index"
            },
            {
              "config": {
                "bucket": "INCOMING_INDEX",
                "kind": "kv-write"
              },
              "name": "incoming_index"
            },
            {
              "config": {
                "bucket": "PREDICATE_INDEX",
                "kind": "kv-write"
              },
              "name": "predicate_index"
            }
          ]
        },
        "workers": 2,
        "batch_size": 10
      }
    },

    "graph-query": {
      "type": "processor",
      "name": "graph-query",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats-request",
                "subject": "graph.query.>"
              },
              "name": "query_requests"
            }
          ],
          "outputs": []
        },
        "request_timeout": "30s",
        "max_traversal_depth": 5,
        "max_traversal_nodes": 100
      }
    },

    "graph-gateway": {
      "type": "gateway",
      "name": "graph-gateway",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "host": "0.0.0.0",
                "kind": "network",
                "port": 8084,
                "protocol": "http"
              },
              "name": "http"
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "nats-request",
                "subject": "graph.query.*"
              },
              "name": "queries"
            }
          ]
        },
        "graphql_path": "/graphql",
        "enable_playground": true
      }
    }
  }
}
