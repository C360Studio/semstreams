{
  "version": "1.4.0",
  "platform": {
    "org": "c360",
    "id": "semstreams-kitchen-sink-ml",
    "type": "comprehensive-semantic",
    "region": "local",
    "instance_id": "semantic-999-ml",
    "environment": "test"
  },
  "nats": {
    "urls": ["nats://localhost:4222"]
  },
  "model_registry": {
    "endpoints": {
      "seminstruct-fast": {
        "provider": "openai",
        "url": "http://seminstruct-fast:8083/v1",
        "model": "qwen3-0.6b",
        "max_tokens": 4096
      },
      "seminstruct-mid-answer": {
        "provider": "openai",
        "url": "http://seminstruct-mid-answer:8083/v1",
        "model": "qwen3-1.7b",
        "max_tokens": 4096
      },
      "seminstruct-mid-summary": {
        "provider": "openai",
        "url": "http://seminstruct-mid-summary:8083/v1",
        "model": "qwen3-1.7b",
        "max_tokens": 4096
      },
      "semembed": {
        "provider": "openai",
        "url": "http://semembed:8081/v1",
        "model": "all-MiniLM-L6-v2",
        "max_tokens": 0
      }
    },
    "capabilities": {
      "intent_classification": { "preferred": ["seminstruct-fast"] },
      "answer_synthesis":      { "preferred": ["seminstruct-mid-answer"] },
      "community_summary":     { "preferred": ["seminstruct-mid-summary"] },
      "anomaly_review":        { "preferred": ["seminstruct-mid-summary"] },
      "embedding":             { "preferred": ["semembed"] }
    },
    "defaults": {
      "model": "seminstruct-mid-answer"
    }
  },
  "services": {
    "service-manager": {
      "name": "service-manager",
      "enabled": true,
      "config": {
        "http_port": 8080,
        "swagger_ui": true,
        "server_info": {
          "title": "SemStreams Kitchen Sink ML API",
          "description": "Comprehensive semantic processing with HTTP embeddings",
          "version": "0.7.0"
        }
      }
    },
    "component-manager": {
      "name": "component-manager",
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "name": "metrics",
      "enabled": true,
      "config": {
        "port": 9090,
        "path": "/metrics",
        "include_go_metrics": true
      }
    },
    "message-logger": {
      "name": "message-logger",
      "enabled": true,
      "config": {
        "buffer_size": 10000,
        "monitor_subjects": ["*", "graph.mutation.>"],
        "enable_kv_query": true,
        "log_level": "INFO"
      }
    },
    "log-forwarder": {
      "name": "log-forwarder",
      "enabled": true,
      "config": {
        "min_level": "DEBUG",
        "exclude_sources": ["flow-service.websocket"]
      }
    },
    "metrics-forwarder": {
      "name": "metrics-forwarder",
      "enabled": true,
      "config": {
        "push_interval": "5s",
        "include_go_metrics": false,
        "include_proc_metrics": false
      }
    }
  },
  "streams": {
    "DOCUMENT": {
      "subjects": [
        "document.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "OBJECTSTORE": {
      "subjects": [
        "objectstore.>"
      ],
      "max_age": "24h",
      "max_bytes": 67108864,
      "discard": "old"
    },
    "RAW": {
      "subjects": [
        "raw.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "RULE": {
      "subjects": [
        "rule.>"
      ],
      "max_age": "24h",
      "max_bytes": 67108864,
      "discard": "old"
    },
    "SENSOR": {
      "subjects": [
        "sensor.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    }
  },
  "components": {
    "udp": {
      "type": "input",
      "name": "udp",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.sensor.udp"
                ]
              },
              "name": "nats_output"
            }
          ]
        },
        "bind": "0.0.0.0",
        "port": 14550,
        "buffer_size": 65536
      }
    },
    "file_documents": {
      "type": "input",
      "name": "file_input",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.document.corpus"
                ]
              },
              "name": "file_out"
            }
          ]
        },
        "path": "/data/testdata/semantic/documents.jsonl",
        "format": "jsonl",
        "interval": "10ms",
        "loop": false
      }
    },
    "file_maintenance": {
      "type": "input",
      "name": "file_input",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.document.corpus"
                ]
              },
              "name": "file_out"
            }
          ]
        },
        "path": "/data/testdata/semantic/maintenance.jsonl",
        "format": "jsonl",
        "interval": "10ms",
        "loop": false
      }
    },
    "file_observations": {
      "type": "input",
      "name": "file_input",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.document.corpus"
                ]
              },
              "name": "file_out"
            }
          ]
        },
        "path": "/data/testdata/semantic/observations.jsonl",
        "format": "jsonl",
        "interval": "10ms",
        "loop": false
      }
    },
    "file_sensor_docs": {
      "type": "input",
      "name": "file_input",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.document.corpus"
                ]
              },
              "name": "file_out"
            }
          ]
        },
        "path": "/data/testdata/semantic/sensor_docs.jsonl",
        "format": "jsonl",
        "interval": "10ms",
        "loop": false
      }
    },
    "file_sensors": {
      "type": "input",
      "name": "file_input",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.sensor.file"
                ]
              },
              "name": "file_out"
            }
          ]
        },
        "path": "/data/testdata/semantic/sensors.jsonl",
        "format": "jsonl",
        "interval": "10ms",
        "loop": false
      }
    },
    "document_processor": {
      "type": "processor",
      "name": "document_processor",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "RAW",
                "subjects": [
                  "raw.document.corpus"
                ]
              },
              "name": "doc_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "content.document.v1"
                },
                "kind": "jetstream",
                "subjects": [
                  "document.processed.entity"
                ]
              },
              "name": "doc_out"
            }
          ]
        },
        "org_id": "c360",
        "platform": "logistics"
      }
    },
    "iot_sensor": {
      "type": "processor",
      "name": "iot_sensor",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "RAW",
                "subjects": [
                  "raw.sensor.>"
                ]
              },
              "name": "sensor_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "iot.sensor.v1"
                },
                "kind": "jetstream",
                "subjects": [
                  "sensor.processed.entity"
                ]
              },
              "name": "sensor_out"
            }
          ]
        },
        "org_id": "c360",
        "platform": "logistics"
      }
    },
    "rule": {
      "type": "processor",
      "name": "rule-processor",
      "enabled": true,
      "config": {
        "pack_id": "semantic-rules",
        "entity_watch_buckets": {"ENTITY_STATES": ["c360.*.*.*.*.*"]},
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "OBJECTSTORE",
                "subjects": [
                  "objectstore.stored.entity"
                ]
              },
              "description": "Stored document entity events",
              "name": "rule_entity_in"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "SENSOR",
                "subjects": [
                  "sensor.processed.entity"
                ]
              },
              "description": "Sensor entity events (bypass ObjectStore)",
              "name": "rule_sensor_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "rule.triggered.alert"
                ]
              },
              "name": "rule_out"
            }
          ]
        },
        "enable_graph_integration": true,
        "graph_event_subject_prefix": "objectstore.stored",
        "inline_rules": [
          {
          "id": "cold-storage-temp-alert",
            "type": "expression",
            "name": "Cold Storage Temperature Alert",
            "description": "Fires when cold storage temperature exceeds safe threshold (40F). OnEnter creates alert triple, OnExit removes it.",
          "enabled": true,
          "entity": {"pattern": "*.*.*.*.*.*"},
          "conditions": [
              {
                "field": "sensor.measurement.fahrenheit",
                "operator": "gte",
                "value": 40.0,
                "required": true
              },
              {
                "field": "geo.location.zone",
                "operator": "contains",
                "value": "cold-storage",
                "required": true
              }
            ],
            "logic": "and",
            "cooldown": "5s",
            "on_enter": [
              {
                "type": "add_triple",
                "predicate": "alert.state.active",
                "object": "cold-storage-violation"
              },
              {
                "type": "publish",
                "subject": "alerts.cold-storage"
              }
            ],
            "on_exit": [
              {
                "type": "remove_triple",
                "predicate": "alert.state.active",
                "object": "cold-storage-violation"
              },
              {
                "type": "publish",
                "subject": "alerts.cold-storage.cleared"
              }
            ],
            "metadata": {
              "severity": "critical",
              "category": "food_safety",
              "tier": 0
            }
          },
          {
          "id": "high-humidity-alert",
            "type": "expression",
            "name": "High Humidity Alert",
            "description": "Fires when humidity exceeds 50% threshold. Demonstrates stateful rule transitions.",
          "enabled": true,
          "entity": {"pattern": "*.*.*.*.*.*"},
          "conditions": [
              {
                "field": "sensor.measurement.percent",
                "operator": "gte",
                "value": 50.0,
                "required": true
              },
              {
                "field": "sensor.classification.type",
                "operator": "eq",
                "value": "humidity",
                "required": true
              }
            ],
            "logic": "and",
            "cooldown": "5s",
            "on_enter": [
              {
                "type": "add_triple",
                "predicate": "alert.state.active",
                "object": "high-humidity-warning"
              },
              {
                "type": "publish",
                "subject": "alerts.humidity"
              }
            ],
            "on_exit": [
              {
                "type": "remove_triple",
                "predicate": "alert.state.active",
                "object": "high-humidity-warning"
              }
            ],
            "metadata": {
              "severity": "warning",
              "category": "environment",
              "tier": 0
            }
          },
          {
          "id": "low-pressure-alert",
            "type": "expression",
            "name": "Low Air Pressure Alert",
            "description": "Fires when compressed air pressure drops below 100 PSI. OnEnter/OnExit demonstrate dynamic graph state.",
          "enabled": true,
          "entity": {"pattern": "*.*.*.*.*.*"},
          "conditions": [
              {
                "field": "sensor.measurement.psi",
                "operator": "lt",
                "value": 100.0,
                "required": true
              },
              {
                "field": "sensor.classification.type",
                "operator": "eq",
                "value": "pressure",
                "required": true
              }
            ],
            "logic": "and",
            "cooldown": "5s",
            "on_enter": [
              {
                "type": "add_triple",
                "predicate": "alert.state.active",
                "object": "low-pressure-warning"
              },
              {
                "type": "publish",
                "subject": "alerts.pressure"
              }
            ],
            "on_exit": [
              {
                "type": "remove_triple",
                "predicate": "alert.state.active",
                "object": "low-pressure-warning"
              }
            ],
            "metadata": {
              "severity": "warning",
              "category": "equipment",
              "tier": 0
            }
          }
        ]
      }
    },
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "interface": {
                  "type": "storage.stored.v1"
                },
                "kind": "jetstream",
                "stream_name": "OBJECTSTORE",
                "subjects": [
                  "objectstore.stored.entity"
                ]
              },
              "description": "Stored document entity events from ObjectStore",
              "name": "objectstore_in"
            },
            {
              "config": {
                "interface": {
                  "type": "iot.sensor.v1"
                },
                "kind": "jetstream",
                "stream_name": "SENSOR",
                "subjects": [
                  "sensor.processed.entity"
                ]
              },
              "description": "Sensor entity events from IoT processor",
              "name": "sensor_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-write"
              },
              "description": "Entity state KV bucket",
              "name": "entity_states"
            }
          ]
        },
        "enable_hierarchy": true
      }
    },
    "graph-index": {
      "type": "processor",
      "name": "graph-index",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "description": "Watch entity state changes",
              "name": "entity_watch"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "OUTGOING_INDEX",
                "kind": "kv-write"
              },
              "description": "Outgoing relationship index",
              "name": "outgoing_index"
            },
            {
              "config": {
                "bucket": "INCOMING_INDEX",
                "kind": "kv-write"
              },
              "description": "Incoming relationship index",
              "name": "incoming_index"
            },
            {
              "config": {
                "bucket": "ALIAS_INDEX",
                "kind": "kv-write"
              },
              "description": "Entity alias index",
              "name": "alias_index"
            },
            {
              "config": {
                "bucket": "PREDICATE_INDEX",
                "kind": "kv-write"
              },
              "description": "Predicate index",
              "name": "predicate_index"
            }
          ]
        },
        "workers": 4,
        "batch_size": 50
      }
    },
    "graph-embedding": {
      "type": "processor",
      "name": "graph-embedding",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "description": "Watch entity state changes",
              "name": "entity_watch"
            }
          ]
        },
        "embedder_type": "http",
        "batch_size": 50
      }
    },
    "graph-clustering": {
      "type": "processor",
      "name": "graph-clustering",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "description": "Watch entity state changes for batch trigger",
              "name": "entity_watch"
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "bucket": "COMMUNITY_INDEX",
                "kind": "kv-write"
              },
              "description": "Community detection results",
              "name": "communities"
            }
          ]
        },
        "detection_interval": "30s",
        "batch_size": 100,
        "enable_llm": true,
        "min_community_size": 2,
        "max_iterations": 100,
        "enable_anomaly_detection": false,
        "anomaly_config": {
          "enabled": true,
          "max_anomalies_per_run": 100,
          "core_anomaly": {
            "enabled": true,
            "min_core_for_hub_analysis": 2
          },
          "semantic_gap": {
            "enabled": true,
            "min_semantic_similarity": 0.7,
            "min_structural_distance": 3
          },
          "virtual_edges": {
            "auto_apply": {
              "enabled": false,
              "min_confidence": 0.95,
              "predicate_template": "inferred.semantic.{band}"
            },
            "review_queue": {
              "enabled": true,
              "min_confidence": 0.7,
              "max_confidence": 0.95,
              "require_llm_classification": false
            }
          }
        }
      }
    },
    "graph-index-spatial": {
      "type": "processor",
      "name": "graph-index-spatial",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "description": "Watch entity state changes",
              "name": "entity_watch"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "SPATIAL_INDEX",
                "kind": "kv-write"
              },
              "description": "Spatial index",
              "name": "spatial_index"
            }
          ]
        },
        "geohash_precision": 6,
        "workers": 4,
        "batch_size": 100
      }
    },
    "graph-index-temporal": {
      "type": "processor",
      "name": "graph-index-temporal",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "description": "Watch entity state changes",
              "name": "entity_watch"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "TEMPORAL_INDEX",
                "kind": "kv-write"
              },
              "description": "Temporal index",
              "name": "temporal_index"
            }
          ]
        },
        "time_resolution": "hour",
        "workers": 4,
        "batch_size": 100
      }
    },
    "graph-query": {
      "type": "processor",
      "name": "graph-query",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats-request",
                "subject": "graph.query.>"
              },
              "description": "Query requests from gateway",
              "name": "query_requests"
            }
          ],
          "outputs": []
        },
        "request_timeout": "30s",
        "max_traversal_depth": 5,
        "max_traversal_nodes": 100
      }
    },
    "graph-gateway": {
      "type": "gateway",
      "name": "graph-gateway",
      "enabled": true,
      "config": {
      "ports": {
        "outputs": [
          {
            "config": {
              "kind": "nats-request",
              "subject": "graph.query.*"
            },
            "name": "graph_queries",
            "required": true
          },
          {
            "config": {
              "kind": "nats-request",
              "subject": "graph.index.query.*"
            },
            "name": "graph_index_queries",
            "required": true
          },
          {
            "config": {
              "interface": {
                "type": "agentic.query",
                "version": "v1"
              },
              "kind": "nats-request",
              "subject": "agentic.query.*"
            },
            "name": "agentic_queries",
            "required": true
          }
        ]
      },
        "graphql_path": "/graphql",
        "mcp_path": "/mcp",
        "enable_playground": true,
        "query_timeout": 60000000000
      }
    },
    "file": {
      "type": "output",
      "name": "file",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "content.document.v1"
                },
                "kind": "jetstream",
                "stream_name": "OBJECTSTORE",
                "subjects": [
                  "objectstore.stored.entity"
                ]
              },
              "name": "file_in"
            }
          ],
          "outputs": []
        },
        "directory": "/tmp",
        "file_prefix": "semstreams-kitchen-sink-ml",
        "format": "jsonl"
      }
    },
    "objectstore": {
      "type": "storage",
      "name": "objectstore",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "DOCUMENT",
                "subjects": [
                  "document.processed.entity"
                ]
              },
              "name": "write"
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "objectstore.stored.entity"
                ]
              },
              "name": "stored"
            }
          ]
        },
        "bucket_name": "semstreams_kitchen_sink_store",
        "data_cache": {
          "enabled": true,
          "strategy": "hybrid",
          "max_size": 5000,
          "ttl": "1h",
          "cleanup_interval": "5m"
        }
      }
    }
  }
}
