{
  "version": "1.0.0",
  "platform": {
    "org": "c360",
    "id": "semstreams-semantic-basic",
    "type": "semantic-processing",
    "region": "local",
    "instance_id": "semantic-001",
    "environment": "test"
  },
  "nats": {
    "urls": ["nats://localhost:4222"]
  },
  "services": {
    "component-manager": {
      "name": "component-manager",
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "name": "metrics",
      "enabled": true,
      "config": {
        "port": 9090,
        "path": "/metrics",
        "include_go_metrics": true
      }
    },
    "message-logger": {
      "name": "message-logger",
      "enabled": true,
      "config": {
        "buffer_size": 1000,
        "monitor_subjects": ["raw.>", "events.>"],
        "enable_kv_query": true,
        "log_level": "DEBUG",
        "output_to_stdout": true
      }
    },
    "log-forwarder": {
      "name": "log-forwarder",
      "enabled": true,
      "config": {
        "min_level": "DEBUG",
        "exclude_sources": ["flow-service.websocket"]
      }
    },
    "metrics-forwarder": {
      "name": "metrics-forwarder",
      "enabled": true,
      "config": {
        "push_interval": "5s",
        "include_go_metrics": false,
        "include_proc_metrics": false
      }
    }
  },
  "streams": {
    "RAW": {
      "subjects": [
        "raw.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "SENSOR": {
      "subjects": [
        "sensor.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    }
  },
  "components": {
    "udp": {
      "type": "input",
      "name": "udp",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.udp.messages"
                ]
              },
              "name": "udp_out"
            }
          ]
        },
        "bind": "0.0.0.0",
        "port": 14550,
        "buffer_size": 65536
      }
    },
    "iot_sensor": {
      "type": "processor",
      "name": "iot_sensor",
      "enabled": true,
      "config": {
        "org_id": "c360",
        "platform": "semstreams",
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "RAW",
                "subjects": [
                  "raw.udp.messages"
                ]
              },
              "name": "sensor_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "domain.iot.sensor.v1"
                },
                "kind": "jetstream",
                "subjects": [
                  "sensor.processed.entity"
                ]
              },
              "name": "sensor_out"
            }
          ]
        }
      }
    },
    "graph": {
      "type": "processor",
      "name": "graph-processor",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "iot.sensor.v1"
                },
                "kind": "jetstream",
                "stream_name": "SENSOR",
                "subjects": [
                  "sensor.processed.entity"
                ]
              },
              "description": "Sensor entity events from IoT processor",
              "name": "sensor_in"
            }
          ],
          "outputs": []
        },
        "workers": 4,
        "queue_size": 1000,
        "message_handler": {
          "processing_timeout": "5s",
          "max_retries": 3
        },
        "data_manager": {
          "kv_bucket": "graph_entities",
          "kv_options": {
            "max_retries": 10,
            "timeout": "5s"
          }
        },
        "indexer": {
          "indexes": {
            "predicate": true,
            "incoming": true,
            "alias": true,
            "spatial": true,
            "temporal": true
          },
          "buckets": {
            "alias": "ALIAS_INDEX",
            "predicate": "PREDICATE_INDEX",
            "incoming": "INCOMING_INDEX",
            "spatial": "SPATIAL_INDEX",
            "temporal": "TEMPORAL_INDEX"
          }
        },
        "querier": {
          "cache_enabled": true,
          "cache_ttl": "5m",
          "max_cache_size": 1000
        }
      }
    }
  }
}
