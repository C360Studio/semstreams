{
  "_phase2_note": "Phase 2 enablement is config-only. To grant proposal tools: add create_rule, update_rule, delete_rule, create_flow, update_flow, delete_flow, create_persona, update_persona, delete_persona, create_flow_template, update_flow_template, delete_flow_template to allowed_tools AND mirror the same list into agentic-tools.config.approval_required. Existing ApprovalFilter transitions the loop to LoopStateAwaitingApproval pending human review. No code changes needed.",
  "_collision_note": "This flow's dispatch is pinned to default_role: ops. For multi-role in one process (e.g., a coordinator that delegates to ops), use the coordinator pattern: see docs/advanced/12-coordinator-pattern.md. If you really do need two dispatches in one process, set distinct consumer_name_suffix values on each and override per-dispatch user.message port subjects so they don't both consume every user message.",
  "version": "1.1.0",
  "platform": {
    "org": "CHANGE_ME",
    "id": "ops-agent",
    "type": "agentic",
    "environment": "production"
  },
  "tier": "agentic",
  "nats": {
    "urls": ["nats://localhost:4222"]
  },
  "model_registry": {
    "endpoints": {
      "general": {
        "provider": "openai",
        "url": "CHANGE_ME",
        "model": "CHANGE_ME",
        "max_tokens": 8192,
        "supports_tools": true,
        "tool_format": "openai"
      },
      "fast": {
        "provider": "openai",
        "url": "CHANGE_ME",
        "model": "CHANGE_ME",
        "max_tokens": 4096,
        "supports_tools": true,
        "tool_format": "openai"
      }
    },
    "defaults": {
      "model": "general"
    },
    "capabilities": {
      "general": { "preferred": ["general"] },
      "fast": { "preferred": ["fast"] },
      "summarization": { "preferred": ["fast"] }
    }
  },
  "services": {
    "service-manager": {
      "enabled": true,
      "config": {
        "http_port": 8080,
        "swagger_ui": true,
        "server_info": {
          "title": "SemStreams Ops Agent — observability diagnosis",
          "description": "Phase 1 ops agent: observes completed agent loops, emits ops.diagnosis.* triples for human review. Phase 2 (proposal tools + approval gate) is config-only — see _phase2_note.",
          "version": "1.0.0"
        }
      }
    },
    "component-manager": {
      "enabled": true,
      "config": {}
    }
  },
  "streams": {
    "AGENT": {
      "subjects": [
        "agent.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "TOOL": {
      "subjects": [
        "tool.execute.>",
        "tool.result.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "USER": {
      "subjects": [
        "user.>"
      ],
      "storage": "file",
      "max_age": "1h",
      "max_bytes": 16777216,
      "discard": "old"
    }
  },
  "components": {
    "objectstore": {
      "type": "storage",
      "name": "objectstore",
      "enabled": true,
      "config": {
        "bucket_name": "AGENT_CONTENT"
      }
    },
    "agentic-dispatch": {
      "type": "processor",
      "name": "agentic-dispatch",
      "enabled": true,
      "config": {
        "default_role": "ops",
        "auto_continue": false,
        "stream_name": "USER",
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "USER",
                "subjects": [
                  "user.message.>"
                ]
              },
              "description": "User messages from any channel (channel.id multi-segment)",
              "name": "user.message",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.complete.*"
                ]
              },
              "description": "Agent completion events",
              "name": "agent.complete",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.task.*"
                ]
              },
              "description": "Task submissions to agent loop",
              "name": "agent.task"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "USER",
                "subjects": [
                  "user.response.*"
                ],
                "interface": {"type": "agentic.user_response", "version": "v1"}
              },
              "description": "Responses back to users",
              "name": "user.response"
            }
          ]
        }
      }
    },
    "agentic-loop": {
      "type": "processor",
      "name": "agentic-loop",
      "enabled": true,
      "config": {
        "max_iterations": 15,
        "timeout": "120s",
        "stream_name": "AGENT",
        "loops_bucket": "AGENT_LOOPS",
        "consumer": {
          "ack_wait": "120s",
          "heartbeat_interval": "60s",
          "max_deliver": 2
        },
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.task.*"
                ]
              },
              "name": "agent.task",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.response.>"
                ]
              },
              "name": "agent.response",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.result.>"
                ]
              },
              "name": "tool.result",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.request.*"
                ]
              },
              "name": "agent.request"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.execute.*"
                ]
              },
              "name": "tool.execute"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.complete.*"
                ]
              },
              "name": "agent.complete"
            },
            {
              "config": {
                "bucket": "AGENT_LOOPS",
                "kind": "kv-write"
              },
              "name": "loops"
            }
          ]
        }
      }
    },
    "agentic-model": {
      "type": "processor",
      "name": "agentic-model",
      "enabled": true,
      "config": {
        "timeout": "120s",
        "retry": {
          "max_attempts": 3,
          "backoff": "exponential"
        },
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.request.>"
                ]
              },
              "name": "agent.request",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.response.*"
                ]
              },
              "name": "agent.response",
              "required": true
            }
          ]
        }
      }
    },
    "agentic-tools": {
      "type": "processor",
      "name": "agentic-tools",
      "enabled": true,
      "config": {
        "stream_name": "TOOL",
        "timeout": "60s",
        "allowed_tools": [
          "query_entity",
          "query_entities",
          "query_relationships",
          "read_loop_result",
          "monitor_workflow_runs",
          "list_rules",
          "get_rule",
          "list_flows",
          "get_flow",
          "list_personas",
          "get_persona",
          "list_flow_templates",
          "get_flow_template",
          "list_components",
          "emit_diagnosis",
          "emit_lesson",
          "submit_work"
        ],
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.execute.>"
                ]
              },
              "name": "tool.execute",
              "required": true
            },
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-read"
              },
              "name": "entity_states"
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.result.*"
                ]
              },
              "name": "tool.result",
              "required": true
            }
          ]
        }
      }
    },
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "enable_hierarchy": true,
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-write"
              },
              "name": "entity_states"
            }
          ]
        }
      }
    }
  }
}
