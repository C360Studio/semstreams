{
  "version": "1.1.0",
  "platform": {
    "org": "c360",
    "id": "crud-tools",
    "type": "agentic-e2e",
    "region": "local",
    "instance_id": "crud-tools-001",
    "environment": "test"
  },
  "tier": "agentic",
  "nats": {
    "urls": ["nats://localhost:4222"]
  },
  "streams": {
    "AGENT": {
      "subjects": [
        "agent.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "TOOL": {
      "subjects": [
        "tool.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "USER": {
      "subjects": [
        "user.>"
      ],
      "storage": "file",
      "max_age": "1h",
      "max_bytes": 16777216,
      "discard": "old"
    }
  },
  "model_registry": {
    "endpoints": {
      "general": {
        "provider": "openai",
        "url": "http://mock-llm:8080/v1",
        "model": "mock-model",
        "max_tokens": 4096,
        "supports_tools": true,
        "tool_format": "openai",
        "stream": true
      }
    },
    "defaults": {
      "model": "general"
    },
    "capabilities": {
      "general": { "preferred": ["general"] }
    }
  },
  "services": {
    "service-manager": {
      "enabled": true,
      "config": {
        "http_port": 8080,
        "swagger_ui": true,
        "server_info": {
          "title": "SemStreams Pattern-B CRUD E2E",
          "description": "Exercises Pattern-B CRUD tools (create_rule, etc.) through a scoped agent.",
          "version": "1.0.0"
        }
      }
    },
    "component-manager": {
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "enabled": true,
      "config": {
        "port": 9090,
        "path": "/metrics"
      }
    }
  },
  "components": {
    "objectstore": {
      "type": "storage",
      "name": "objectstore",
      "enabled": true,
      "config": {
        "bucket_name": "AGENT_CONTENT"
      }
    },
    "agentic-dispatch": {
      "type": "processor",
      "name": "agentic-dispatch",
      "enabled": true,
      "config": {
        "default_role": "general",
        "default_tools": ["create_rule", "list_rules", "get_rule"],
        "auto_continue": false,
        "stream_name": "USER",
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "USER",
                "subjects": [
                  "user.message.>"
                ]
              },
              "name": "user.message",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.complete.*"
                ]
              },
              "name": "agent.complete",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.task.*"
                ]
              },
              "name": "agent.task"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "USER",
                "subjects": [
                  "user.response.*"
                ]
              },
              "name": "user.response"
            }
          ]
        }
      }
    },
    "agentic-loop": {
      "type": "processor",
      "name": "agentic-loop",
      "enabled": true,
      "config": {
        "max_iterations": 4,
        "timeout": "15s",
        "stream_name": "AGENT",
        "loops_bucket": "AGENT_LOOPS",
        "consumer": {
          "ack_wait": "15s",
          "heartbeat_interval": "10s",
          "max_deliver": 2
        },
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.task.*"
                ]
              },
              "name": "agent.task",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.response.>"
                ]
              },
              "name": "agent.response",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.result.>"
                ]
              },
              "name": "tool.result",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.request.*"
                ]
              },
              "name": "agent.request"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.execute.*"
                ]
              },
              "name": "tool.execute"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.complete.*"
                ]
              },
              "name": "agent.complete"
            },
            {
              "config": {
                "bucket": "AGENT_LOOPS",
                "kind": "kv-write"
              },
              "name": "loops"
            }
          ]
        }
      }
    },
    "agentic-model": {
      "type": "processor",
      "name": "agentic-model",
      "enabled": true,
      "config": {
        "timeout": "15s",
        "retry": {
          "max_attempts": 2,
          "backoff": "exponential"
        },
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.request.>"
                ]
              },
              "name": "agent.request",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.response.*"
                ]
              },
              "name": "agent.response",
              "required": true
            }
          ]
        }
      }
    },
    "agentic-tools": {
      "type": "processor",
      "name": "agentic-tools",
      "enabled": true,
      "config": {
        "stream_name": "TOOL",
        "timeout": "10s",
        "allowed_tools": ["create_rule", "update_rule", "delete_rule", "list_rules", "get_rule"],
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.execute.>"
                ]
              },
              "name": "tool.execute",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.result.*"
                ]
              },
              "name": "tool.result",
              "required": true
            }
          ]
        }
      }
    },
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "enable_hierarchy": true,
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-write"
              },
              "name": "entity_states"
            }
          ]
        }
      }
    },
    "rule-processor": {
      "type": "processor",
      "name": "rule-processor",
      "enabled": true,
      "config": {
        "pack_id": "crud-tools-test-rules",
        "enable_graph_integration": false,
        "entity_watch_buckets": {
          "ENTITY_STATES": ["*.*.*.*.*.*"]
        },
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "name": "entity_states"
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.task.*"
                ]
              },
              "name": "agent.task"
            },
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            }
          ]
        }
      }
    }
  }
}
