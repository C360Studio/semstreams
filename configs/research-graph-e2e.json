{
  "_doc": [
    "ADR-045 Phase 1 research-graph e2e configuration.",
    "Wires the five research-graph components + agentic-loop/dispatch/tools/model + graph-ingest/query + rule-processor (loading R0-R6 pack) against a mock LLM endpoint for deterministic e2e validation.",
    "Used by docker/compose/research-graph.yml + task e2e:research-graph.",
    "Reference flow at configs/examples/research-graph-pipeline.json is the operator-facing template; this file is the e2e-tuned variant."
  ],
  "version": "1.0.1",
  "platform": {
    "org": "c360",
    "id": "research-graph-e2e",
    "type": "agentic-e2e",
    "region": "local",
    "instance_id": "rg-e2e-001",
    "environment": "test"
  },
  "tier": "agentic",
  "nats": {
    "urls": ["nats://localhost:4222"]
  },
  "model_registry": {
    "endpoints": {
      "mock": {
        "provider": "openai",
        "url": "http://mock-llm:8080/v1",
        "model": "mock-model",
        "max_tokens": 4096,
        "supports_tools": true,
        "tool_format": "openai",
        "stream": false
      }
    },
    "defaults": {
      "model": "mock"
    },
    "capabilities": {
      "general":             { "preferred": ["mock"] },
      "research_routing":    { "preferred": ["mock"] },
      "research_assessment": { "preferred": ["mock"] },
      "research_synthesis":  { "preferred": ["mock"] }
    }
  },
  "services": {
    "service-manager": {
      "enabled": true,
      "config": {
        "http_port": 8080,
        "swagger_ui": true,
        "server_info": {
          "title": "SemStreams ADR-045 Research-Graph E2E",
          "description": "Phase 1 chain end-to-end against mock LLM.",
          "version": "0.1.0"
        }
      }
    },
    "component-manager": {
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "enabled": true,
      "config": {
        "port": 9090,
        "path": "/metrics"
      }
    },
    "message-logger": {
      "enabled": true,
      "config": {
        "monitor_subjects": ["agent.*", "tool.*", "component.*", "graph.mutation.>"]
      }
    },
    "log-forwarder": {
      "enabled": true,
      "config": {
        "min_level": "DEBUG",
        "exclude_sources": []
      }
    }
  },
  "_streams_doc": "agentic-dispatch consumes user.message.> from the USER stream (required input), but no component in this e2e produces user.message (the scenario injects directly to agent.task.*), so EnsureStreams — which derives streams from OUTPUT ports — never creates USER. Declare it explicitly (mirrors deep-research-test/ops-agent-test/crud-tools-test). AGENT/TOOL take their subjects from their output-port producers, but every ordinary stream must declare finite max_age, finite max_bytes, and a discard policy, so they are declared here too. gh#390.",
  "streams": {
    "AGENT": {
      "subjects": [
        "agent.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "TOOL": {
      "subjects": [
        "tool.execute.>",
        "tool.result.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "USER": {
      "subjects": [
        "user.>"
      ],
      "storage": "file",
      "max_age": "1h",
      "max_bytes": 16777216,
      "discard": "old"
    }
  },
  "components": {
    "objectstore": {
      "type": "storage",
      "name": "objectstore",
      "enabled": true,
      "config": {
        "bucket_name": "AGENT_CONTENT"
      }
    },
    "agentic-dispatch": {
      "type": "processor",
      "name": "agentic-dispatch",
      "enabled": true,
      "config": {
        "default_role": "general",
        "default_tools": ["research_graph", "read_loop_result"],
        "auto_continue": false,
        "stream_name": "USER",
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "USER",
                "subjects": [
                  "user.message.>"
                ]
              },
              "name": "user.message",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.complete.*"
                ]
              },
              "name": "agent.complete",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.task.*"
                ]
              },
              "name": "agent.task"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "USER",
                "subjects": [
                  "user.response.*"
                ]
              },
              "name": "user.response"
            }
          ]
        }
      }
    },
    "agentic-loop": {
      "type": "processor",
      "name": "agentic-loop",
      "enabled": true,
      "config": {
        "max_iterations": 5,
        "timeout": "120s",
        "stream_name": "AGENT",
        "loops_bucket": "AGENT_LOOPS",
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.task.*"
                ]
              },
              "name": "agent.task",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.response.>"
                ]
              },
              "name": "agent.response",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.result.>"
                ]
              },
              "name": "tool.result",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.request.*"
                ]
              },
              "name": "agent.request"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.execute.*"
                ]
              },
              "name": "tool.execute"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.complete.*"
                ]
              },
              "name": "agent.complete"
            },
            {
              "config": {
                "bucket": "AGENT_LOOPS",
                "kind": "kv-write"
              },
              "name": "loops"
            }
          ]
        }
      }
    },
    "agentic-model": {
      "type": "processor",
      "name": "agentic-model",
      "enabled": true,
      "config": {
        "timeout": "120s",
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.request.>"
                ]
              },
              "name": "agent.request",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.response.*"
                ]
              },
              "name": "agent.response",
              "required": true
            }
          ]
        }
      }
    },
    "agentic-tools": {
      "type": "processor",
      "name": "agentic-tools",
      "enabled": true,
      "config": {
        "stream_name": "TOOL",
        "timeout": "60s",
        "allowed_tools": ["research_graph", "read_loop_result", "decide"],
        "loops_bucket": "AGENT_LOOPS",
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.execute.>"
                ]
              },
              "name": "tool.execute",
              "required": true
            },
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-read"
              },
              "name": "entity_states"
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "TOOL",
                "subjects": [
                  "tool.result.*"
                ]
              },
              "name": "tool.result",
              "required": true
            }
          ]
        }
      }
    },
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "enable_hierarchy": true,
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-write"
              },
              "name": "entity_states"
            }
          ]
        }
      }
    },
    "graph-query": {
      "type": "processor",
      "name": "graph-query",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats-request",
                "subject": "graph.query.*",
                "interface": {"type": "graph.query", "version": "v1"}
              },
              "name": "graph_queries",
              "required": true
            }
          ]
        }
      }
    },
    "research-graph-classify": {
      "type": "processor",
      "name": "research-graph-classify",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats",
                "subject": "component.nl_classify.>"
              },
              "name": "classify_trigger",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "interface": {"type": "graph.query", "version": "v1"},
                "kind": "nats-request",
                "subject": "graph.query.searchGraph"
              },
              "name": "searchGraph",
              "required": true
            }
          ]
        }
      }
    },
    "research-graph-route": {
      "type": "processor",
      "name": "research-graph-route",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats",
                "subject": "component.route_search.>"
              },
              "name": "route_trigger",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            }
          ]
        }
      }
    },
    "research-graph-execute": {
      "type": "processor",
      "name": "research-graph-execute",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats",
                "subject": "component.execute_subqueries.>"
              },
              "name": "execute_trigger",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "interface": {"type": "graph.query", "version": "v1"},
                "kind": "nats-request",
                "subject": "graph.query.batch"
              },
              "name": "batch",
              "required": true
            },
            {
              "config": {
                "interface": {"type": "graph.query", "version": "v1"},
                "kind": "nats-request",
                "subject": "graph.query.relationships"
              },
              "name": "relationships",
              "required": true
            },
            {
              "config": {
                "interface": {"type": "graph.query", "version": "v1"},
                "kind": "nats-request",
                "subject": "graph.query.temporal"
              },
              "name": "temporal",
              "required": true
            },
            {
              "config": {
                "interface": {"type": "graph.query", "version": "v1"},
                "kind": "nats-request",
                "subject": "graph.query.searchGraph"
              },
              "name": "searchGraph",
              "required": true
            }
          ]
        }
      }
    },
    "research-graph-assess": {
      "type": "processor",
      "name": "research-graph-assess",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats",
                "subject": "component.assess_sufficiency.>"
              },
              "name": "assess_trigger",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            }
          ]
        }
      }
    },
    "research-graph-synthesize": {
      "type": "processor",
      "name": "research-graph-synthesize",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats",
                "subject": "component.synthesize_answer.>"
              },
              "name": "synthesize_trigger",
              "required": true
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            }
          ]
        }
      }
    },
    "rule-processor": {
      "type": "processor",
      "name": "rule-processor",
      "enabled": true,
      "config": {
        "pack_id": "research-graph-e2e-rules",
        "rules_files": [
          "/app/configs/rules/research-graph/00-kickoff-classify.json",
          "/app/configs/rules/research-graph/01-classify-routes.json",
          "/app/configs/rules/research-graph/02-route-decision-dispatch.json",
          "/app/configs/rules/research-graph/03-execute-assesses.json",
          "/app/configs/rules/research-graph/04-assess-dispatch.json",
          "/app/configs/rules/research-graph/05-continuation.json"
        ],
        "enable_graph_integration": true,
        "entity_watch_buckets": {
          "ENTITY_STATES": ["*.*.*.*.*.*"]
        },
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "name": "entity_states"
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "nats",
                "subject": "component.*"
              },
              "description": "Per-stage dispatch published by R0-R4",
              "name": "component.dispatch"
            },
            {
              "config": {
                "kind": "jetstream",
                "stream_name": "AGENT",
                "subjects": [
                  "agent.task.*"
                ]
              },
              "description": "R6 continuation publishes back to parent role",
              "name": "agent.task"
            },
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "description": "Canonical graph mutation request/reply interface",
              "name": "graph_mutations",
              "required": true
            }
          ]
        }
      }
    }
  }
}
