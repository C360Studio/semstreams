{
  "id": "collect_research_evidence",
  "type": "expression",
  "name": "Collect Research Evidence",
  "description": "When a researcher completes successfully, store findings in the RESEARCH_EVIDENCE KV bucket and write a graph triple linking the finding to the research task. Downstream rule 04 watches RESEARCH_EVIDENCE and fires synthesis once evidence is collected.",
  "enabled": true,
  "conditions": [
    {
      "field": "agent.loop.role",
      "operator": "eq",
      "value": "researcher"
    },
    {
      "field": "agent.loop.outcome",
      "operator": "eq",
      "value": "success"
    }
  ],
  "logic": "and",
  "on_enter": [
    {
      "type": "update_kv",
      "bucket": "RESEARCH_EVIDENCE",
      "key": "evidence.$entity.triple.agent.loop.task",
      "payload": {
        "task_id": "$entity.triple.agent.loop.task",
        "loop_id": "$entity.id",
        "role": "researcher",
        "findings": "$entity.triple.agent.loop.result",
        "collected_at": "$now"
      },
      "merge": false
    },
    {
      "type": "add_triple",
      "predicate": "research.has_evidence",
      "object": "evidence.$entity.triple.agent.loop.task"
    }
  ]
}
