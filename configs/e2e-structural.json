{
  "version": "1.1.0",
  "platform": {
    "org": "c360",
    "id": "semstreams-e2e-structural",
    "type": "reactive-e2e",
    "region": "local",
    "instance_id": "e2e-structural-001",
    "environment": "test"
  },
  "tier": "rules",
  "nats": {
    "urls": ["nats://localhost:4222"]
  },
  "services": {
    "service-manager": {
      "name": "service-manager",
      "enabled": true,
      "config": {
        "http_port": 8080,
        "swagger_ui": true,
        "server_info": {
          "title": "SemStreams E2E Structural Tier",
          "description": "E2E test application with reactive workflow engine",
          "version": "0.7.0"
        }
      }
    },
    "component-manager": {
      "name": "component-manager",
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "name": "metrics",
      "enabled": true,
      "config": {
        "port": 9090,
        "path": "/metrics",
        "include_go_metrics": true
      }
    },
    "message-logger": {
      "name": "message-logger",
      "enabled": true,
      "config": {
        "buffer_size": 10000,
        "monitor_subjects": ["*", "graph.mutation.>"],
        "enable_kv_query": true,
        "log_level": "INFO"
      }
    },
    "log-forwarder": {
      "name": "log-forwarder",
      "enabled": true,
      "config": {
        "min_level": "DEBUG",
        "exclude_sources": ["flow-service.websocket"]
      }
    },
    "metrics-forwarder": {
      "name": "metrics-forwarder",
      "enabled": true,
      "config": {
        "push_interval": "5s",
        "include_go_metrics": false,
        "include_proc_metrics": false
      }
    }
  },
  "streams": {
    "DOCUMENT": {
      "subjects": [
        "document.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "OBJECTSTORE": {
      "subjects": [
        "objectstore.>"
      ],
      "max_age": "24h",
      "max_bytes": 67108864,
      "discard": "old"
    },
    "RAW": {
      "subjects": [
        "raw.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "SENSOR": {
      "subjects": [
        "sensor.>"
      ],
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "WORKFLOW": {
      "subjects": [
        "workflow.>"
      ],
      "max_age": "24h",
      "max_bytes": 67108864,
      "discard": "old"
    }
  },
  "components": {
    "file_sensors": {
      "type": "input",
      "name": "file_input",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.sensor.file"
                ]
              },
              "name": "file_out"
            }
          ]
        },
        "path": "/data/testdata/semantic/sensors.jsonl",
        "format": "jsonl",
        "interval": "10ms",
        "loop": false
      }
    },
    "file_documents": {
      "type": "input",
      "name": "file_input",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.document.corpus"
                ]
              },
              "name": "file_out"
            }
          ]
        },
        "path": "/data/testdata/semantic/documents.jsonl",
        "format": "jsonl",
        "interval": "10ms",
        "loop": false
      }
    },
    "file_maintenance": {
      "type": "input",
      "name": "file_input",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.document.corpus"
                ]
              },
              "name": "file_out"
            }
          ]
        },
        "path": "/data/testdata/semantic/maintenance.jsonl",
        "format": "jsonl",
        "interval": "10ms",
        "loop": false
      }
    },
    "file_observations": {
      "type": "input",
      "name": "file_input",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.document.corpus"
                ]
              },
              "name": "file_out"
            }
          ]
        },
        "path": "/data/testdata/semantic/observations.jsonl",
        "format": "jsonl",
        "interval": "10ms",
        "loop": false
      }
    },
    "file_sensor_docs": {
      "type": "input",
      "name": "file_input",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.document.corpus"
                ]
              },
              "name": "file_out"
            }
          ]
        },
        "path": "/data/testdata/semantic/sensor_docs.jsonl",
        "format": "jsonl",
        "interval": "10ms",
        "loop": false
      }
    },
    "udp": {
      "type": "input",
      "name": "udp",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.sensor.udp"
                ]
              },
              "name": "udp_out"
            }
          ]
        },
        "bind": "0.0.0.0",
        "port": 14550,
        "buffer_size": 65536
      }
    },
    "iot_sensor": {
      "type": "processor",
      "name": "iot_sensor",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.sensor.>"
                ]
              },
              "name": "sensor_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "iot.sensor.v1"
                },
                "kind": "jetstream",
                "subjects": [
                  "sensor.processed.entity"
                ]
              },
              "name": "sensor_out"
            }
          ]
        },
        "org_id": "c360",
        "platform": "logistics"
      }
    },
    "document_processor": {
      "type": "processor",
      "name": "document_processor",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "raw.document.corpus"
                ]
              },
              "name": "doc_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "content.document.v1"
                },
                "kind": "jetstream",
                "subjects": [
                  "document.processed.entity"
                ]
              },
              "name": "doc_out"
            }
          ]
        },
        "org_id": "c360",
        "platform": "logistics"
      }
    },
    "objectstore": {
      "type": "storage",
      "name": "objectstore",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "document.processed.entity"
                ]
              },
              "name": "write"
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "objectstore.stored.entity"
                ]
              },
              "name": "stored"
            }
          ]
        },
        "bucket_name": "semstreams_e2e_structural_store",
        "data_cache": {"enabled": true, "strategy": "hybrid", "max_size": 5000, "ttl": "1h", "cleanup_interval": "5m"}
      }
    },
    "rule": {
      "type": "processor",
      "name": "rule-processor",
      "enabled": true,
      "config": {
        "pack_id": "e2e-structural-rules",
        "enable_graph_integration": true,
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "name": "entity_watch"
            }
          ],
          "outputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "workflow.trigger.*"
                ]
              },
              "name": "workflow_triggers"
            }
          ]
        },
        "entity_watch_buckets": {"ENTITY_STATES": ["*.*.*.*.*.*"]},
        "inline_rules": [
          {
            "id": "cold-storage-temp-violation",
            "type": "expression",
            "name": "Cold Storage Temperature Violation",
            "enabled": true,
            "entity": {"pattern": "*.*.*.*.*.*"},
            "conditions": [
              {"field": "sensor.measurement.fahrenheit", "operator": "gte", "value": 40},
              {"field": "geo.location.zone", "operator": "contains", "value": "cold-storage"}
            ],
            "on_enter": [
              {
                "type": "trigger_workflow",
                "workflow_id": "notify-technician"
              }
            ]
          }
        ]
      }
    },
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "interface": {
                  "type": "semstreams.graph.mutation"
                },
                "kind": "nats-request",
                "subject": "graph.mutation.>"
              },
              "name": "graph_mutations",
              "required": true
            },
            {
              "config": {
                "interface": {
                  "type": "storage.stored.v1"
                },
                "kind": "jetstream",
                "subjects": [
                  "objectstore.stored.entity"
                ]
              },
              "name": "objectstore_in"
            },
            {
              "config": {
                "interface": {
                  "type": "iot.sensor.v1"
                },
                "kind": "jetstream",
                "subjects": [
                  "sensor.processed.entity"
                ]
              },
              "name": "sensor_in"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-write"
              },
              "name": "entity_states"
            }
          ]
        },
        "enable_hierarchy": true
      }
    },
    "graph-index": {
      "type": "processor",
      "name": "graph-index",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "name": "entity_watch"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "OUTGOING_INDEX",
                "kind": "kv-write"
              },
              "name": "outgoing_index"
            },
            {
              "config": {
                "bucket": "INCOMING_INDEX",
                "kind": "kv-write"
              },
              "name": "incoming_index"
            },
            {
              "config": {
                "bucket": "ALIAS_INDEX",
                "kind": "kv-write"
              },
              "name": "alias_index"
            },
            {
              "config": {
                "bucket": "PREDICATE_INDEX",
                "kind": "kv-write"
              },
              "name": "predicate_index"
            }
          ]
        },
        "workers": 4,
        "batch_size": 50
      }
    },
    "graph-index-spatial": {
      "type": "processor",
      "name": "graph-index-spatial",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "name": "entity_watch"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "SPATIAL_INDEX",
                "kind": "kv-write"
              },
              "name": "spatial_index"
            }
          ]
        },
        "geohash_precision": 6,
        "workers": 2,
        "batch_size": 50
      }
    },
    "graph-index-temporal": {
      "type": "processor",
      "name": "graph-index-temporal",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "bucket": "ENTITY_STATES",
                "kind": "kv-watch"
              },
              "name": "entity_watch"
            }
          ],
          "outputs": [
            {
              "config": {
                "bucket": "TEMPORAL_INDEX",
                "kind": "kv-write"
              },
              "name": "temporal_index"
            }
          ]
        },
        "time_resolution": "hour",
        "workers": 2,
        "batch_size": 50
      }
    },
    "graph-query": {
      "type": "processor",
      "name": "graph-query",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "nats-request",
                "subject": "graph.query.>"
              },
              "name": "query_requests"
            }
          ],
          "outputs": []
        },
        "request_timeout": "30s",
        "max_traversal_depth": 5,
        "max_traversal_nodes": 100
      }
    },
    "graph-gateway": {
      "type": "gateway",
      "name": "graph-gateway",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "host": "0.0.0.0",
                "kind": "network",
                "port": 8082,
                "protocol": "http"
              },
              "name": "http"
            }
          ],
          "outputs": [
            {
              "config": {
                "kind": "nats-request",
                "subject": "graph.query.*"
              },
              "name": "queries"
            }
          ]
        },
        "graphql_path": "/graphql",
        "mcp_path": "/mcp",
        "enable_playground": true
      }
    },
    "file": {
      "type": "output",
      "name": "file",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "config": {
                "kind": "jetstream",
                "subjects": [
                  "objectstore.stored.entity"
                ]
              },
              "name": "file_in"
            }
          ],
          "outputs": []
        },
        "directory": "/tmp",
        "file_prefix": "semstreams-e2e-structural",
        "format": "jsonl"
      }
    }
  }
}
