{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rule-processor.v1.json",
  "type": "object",
  "title": "rule-processor Configuration",
  "description": "Rule execution processor",
  "properties": {
    "alert_cooldown_period": {
      "type": "string",
      "description": "Minimum time between repeated alerts (e.g. '2m')",
      "default": "2m",
      "category": "advanced"
    },
    "buffer_window_size": {
      "type": "string",
      "description": "Time window for message buffering (e.g. '10m')",
      "default": "10m",
      "category": "advanced"
    },
    "debounce_delay_ms": {
      "type": "integer",
      "description": "Debounce delay in milliseconds for rule evaluation (0=disabled)",
      "default": 0,
      "category": "advanced"
    },
    "enable_graph_integration": {
      "type": "boolean",
      "description": "Enable graph entity creation from rules; every rule processor requires an explicit pack_id",
      "default": false,
      "category": "basic"
    },
    "entity_watch_buckets": {
      "type": "object",
      "description": "ENTITY_STATES watch patterns for the rule processor's typed EntityState evaluator.",
      "category": "advanced",
      "properties": {
        "ENTITY_STATES": {
          "type": "array",
          "description": "Exact six-position entity ID patterns.",
          "items": {
            "type": "string",
            "description": "Exact six-position entity ID pattern; each position is a canonical literal segment or *.",
            "maxLength": 256,
            "pattern": "^(?:\\*|[A-Za-z0-9][A-Za-z0-9_-]*)(?:\\.(?:\\*|[A-Za-z0-9][A-Za-z0-9_-]*)){5}$"
          }
        }
      },
      "additionalProperties": false
    },
